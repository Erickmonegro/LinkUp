@using LinkUpPro.Core.Application.ViewModels.Battleship
@using LinkUpPro.Core.Application.DTOs.FriendshipDTO
@model CreateMatchViewModel

@{
    ViewData["Title"] = "Nueva Partida de Battleship";
    var friends = ViewBag.Friends as List<FriendshipDTO>;
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-3 border-b border-gray-200 pb-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue text-2xl shadow-sm">
            <i class="fas fa-ship"></i>
        </div>
        <div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">Nueva Partida</h2>
            <p class="text-sm text-gray-500">Desafía a uno de tus amigos a una batalla naval estratégica</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form asp-action="CreateMatch" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Player2Id" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Selecciona a un Amigo</label>
                @if (friends != null && friends.Any())
                {
                    <select asp-for="Player2Id" class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl font-medium text-gray-800 focus:bg-white focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all cursor-pointer">
                        <option value="" disabled selected>-- Elige con quién quieres jugar --</option>
                        @foreach (var friend in friends)
                        {
                            <option value="@friend.FriendId">@friend.FriendName</option>
                        }
                    </select>
                    <span asp-validation-for="Player2Id" class="text-red-500 text-xs mt-1 font-semibold block"></span>
                }
                else
                {
                    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl text-sm flex items-start gap-3">
                        <i class="fas fa-user-friends text-amber-600 text-lg mt-0.5"></i>
                        <div>
                            <p class="font-bold">No tienes amigos activos actualmente</p>
                            <p class="text-xs text-amber-700 mt-1">Para jugar a Battleship necesitas agregar y tener amigos aceptados en tu lista.</p>
                            <a asp-controller="Friendship" asp-action="Index" class="inline-block mt-2 text-xs font-bold text-brand-blue hover:underline">Ir a la sección de Amigos &rarr;</a>
                        </div>
                    </div>
                    <!-- Hidden field to allow form structure if needed -->
                    <input type="hidden" asp-for="Player2Id" value="" />
                }
            </div>

            <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-4 text-xs text-gray-600 space-y-1">
                <p class="font-bold text-brand-blue flex items-center gap-1.5"><i class="fas fa-info-circle"></i> ¿Cómo funciona?</p>
                <p>Al crear la partida, tu amigo y tú entrarán en fase de preparación para colocar en secreto sus flota de barcos en un tablero de 10x10. ¡Cuando ambos estén listos, iniciará la batalla!</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors">
                    Cancelar
                </a>
                @if (friends != null && friends.Any())
                {
                    <button type="submit" class="bg-brand-blue text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-blue-800 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                        <i class="fas fa-gamepad"></i> Crear Desafío
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
