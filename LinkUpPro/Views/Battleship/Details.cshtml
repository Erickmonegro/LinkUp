@using LinkUpPro.Core.Application.ViewModels.Battleship
@using LinkUpPro.Core.Application.DTOs.Battleship
@using LinkUpPro.Core.Domain.Common.Enums
@using LinkUpPro.Core.Domain.Entities
@model BattleshipMatchViewModel

@{
    ViewData["Title"] = "Detalles de la Partida";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    bool isWinner = Model.WinnerId == currentUserId;
    bool isLoser = !isWinner && (Model.Player1Id == currentUserId || Model.Player2Id == currentUserId) && !string.IsNullOrEmpty(Model.WinnerId);

    var ships = ViewBag.Ships as List<ShipPositionDTO> ?? new List<ShipPositionDTO>();
    var attacks = ViewBag.Attacks as List<AttackDTO> ?? new List<AttackDTO>();

    var p1Ships = ships.Where(s => s.UserId == Model.Player1Id).ToList();
    var p2Ships = ships.Where(s => s.UserId == Model.Player2Id).ToList();
    var p1Attacks = attacks.Where(a => a.AttackerId == Model.Player1Id).ToList();
    var p2Attacks = attacks.Where(a => a.AttackerId == Model.Player2Id).ToList();

    TimeSpan duration = TimeSpan.Zero;
    var start = Model.TurnAssignedAt > DateTime.MinValue && Model.TurnAssignedAt.Year >= 2020 ? Model.TurnAssignedAt : Model.CreatedAt;
    var end = Model.EndDate ?? DateTime.UtcNow;
    if (end > start && start.Year >= 2020)
    {
        duration = end - start;
    }
    else if (attacks.Any())
    {
        var firstTime = attacks.Min(a => a.Created);
        var lastTime = attacks.Max(a => a.Created);
        if (lastTime > firstTime)
        {
            duration = lastTime - firstTime;
        }
    }
    double totalHours = Math.Max(0.1, Math.Round(duration.TotalHours, 1));
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue text-2xl shadow-sm">
                <i class="fas fa-ship"></i>
            </div>
            <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">Sala de Batalla #@Model.Id</h2>
                <p class="text-sm text-gray-500">Consulta el estado y gestiona tus flotas de combate</p>
            </div>
        </div>
        <div>
            @if (Model.Status == MatchStatus.Pending)
            {
                <span class="px-3 py-1.5 bg-amber-100 text-amber-800 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Fase de Preparación
                </span>
            }
            else if (Model.Status == MatchStatus.InProgress)
            {
                <span class="px-3 py-1.5 bg-green-100 text-green-800 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> En Combate
                </span>
            }
            else
            {
                <span class="px-3 py-1.5 bg-gray-200 text-gray-800 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fas fa-flag-checkered text-gray-600"></i> Partida Finalizada
                </span>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium">
            <i class="fas fa-info-circle text-blue-500 text-lg"></i>
            <span>@TempData["Info"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Players Card -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-blue-500"></div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Jugador 1 (Retador)</p>
            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                <i class="fas fa-user-shield text-blue-500"></i>
                @(Model.Player1Name ?? Model.Player1Id)
            </h3>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-red-500"></div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Jugador 2 (Desafiado)</p>
            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                <i class="fas fa-crosshairs text-red-500"></i>
                @(Model.Player2Name ?? Model.Player2Id)
            </h3>
        </div>
    </div>

    @if (Model.Status == MatchStatus.ChallengePending)
    {
        @if (Model.Player2Id == currentUserId)
        {
            <div class="bg-gradient-to-r from-purple-900 via-indigo-900 to-slate-900 rounded-3xl p-8 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 border border-purple-500/50 animate-fade-in">
                <div class="flex items-center gap-5 z-10">
                    <div class="w-16 h-16 rounded-2xl bg-purple-500/20 flex items-center justify-center text-3xl border border-purple-500/30">
                        <i class="fas fa-scroll text-purple-400 animate-pulse"></i>
                    </div>
                    <div>
                        <span class="px-3 py-1 bg-purple-500/20 text-purple-300 rounded-full text-xs font-black uppercase tracking-wider">DESAFÍO ENTRANTE</span>
                        <h3 class="text-2xl font-black mt-1">¡@Model.Player1Name te ha desafiado!</h3>
                        <p class="text-purple-200 text-sm mt-0.5">¿Aceptas el reto para enfrentar tus flotas en combate naval?</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 z-10">
                    <form asp-controller="Battleship" asp-action="AcceptChallenge" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-black text-sm transition-all shadow-lg flex items-center gap-2">
                            <i class="fas fa-check"></i> Aceptar Desafío
                        </button>
                    </form>
                    <form asp-controller="Battleship" asp-action="RejectChallenge" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="bg-red-600/80 hover:bg-red-600 text-white px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center gap-2">
                            <i class="fas fa-times"></i> Rechazar
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="bg-slate-800 rounded-3xl p-8 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 border border-slate-700">
                <div class="flex items-center gap-4">
                    <i class="fas fa-hourglass-half text-amber-400 text-3xl animate-spin-slow"></i>
                    <div>
                        <h3 class="text-xl font-black">Desafío enviado a @Model.Player2Name</h3>
                        <p class="text-slate-400 text-sm mt-0.5">Esperando a que el contrincante acepte el desafío para comenzar la preparación...</p>
                    </div>
                </div>
                <div>
                    <form asp-controller="Battleship" asp-action="RejectChallenge" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="bg-red-600/80 hover:bg-red-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm transition-all flex items-center gap-2">
                            <i class="fas fa-ban"></i> Cancelar Solicitud
                        </button>
                    </form>
                </div>
            </div>
        }
    }

    @if (Model.Status == MatchStatus.Finished)
    {
        <!-- BANNER DE RESULTADO GANADOR / PERDEDOR -->
        @if (isWinner)
        {
            <div class="bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-600 rounded-3xl p-8 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 border-2 border-amber-300 relative overflow-hidden animate-fade-in">
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="flex items-center gap-5 z-10">
                    <div class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center text-3xl shadow-inner border border-white/30 animate-bounce">
                        <i class="fas fa-trophy text-yellow-200"></i>
                    </div>
                    <div>
                        <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-black uppercase tracking-wider text-yellow-100">¡VICTORIA GLORIOSA!</span>
                        <h3 class="text-3xl font-black mt-1">¡Felicidades, has ganado la batalla!</h3>
                        <p class="text-amber-100 text-sm mt-0.5">Demostraste una estrategia naval impecable hundiendo la flota enemiga.</p>
                    </div>
                </div>
                <div class="z-10 text-right">
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-200 block">Condición de Victoria</span>
                    <span class="text-2xl font-black">Flota Rival Aniquilada</span>
                </div>
            </div>
        }
        else if (isLoser)
        {
            <div class="bg-gradient-to-r from-slate-900 via-red-950 to-slate-900 rounded-3xl p-8 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 border border-red-800/60 relative overflow-hidden animate-fade-in">
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-red-500/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="flex items-center gap-5 z-10">
                    <div class="w-16 h-16 rounded-2xl bg-red-500/20 flex items-center justify-center text-3xl shadow-inner border border-red-500/30">
                        <i class="fas fa-skull-crossbones text-red-400"></i>
                    </div>
                    <div>
                        <span class="px-3 py-1 bg-red-500/20 text-red-300 rounded-full text-xs font-black uppercase tracking-wider">DERROTA EN COMBATE</span>
                        <h3 class="text-3xl font-black mt-1">Has perdido esta partida...</h3>
                        <p class="text-slate-300 text-sm mt-0.5">Tu flota ha sido hundida en combate. ¡Analiza los tableros y prepárate para la revancha!</p>
                    </div>
                </div>
                <div class="z-10 text-right">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Ganador del Combate</span>
                    <span class="text-2xl font-black text-amber-400">@Model.WinnerName</span>
                </div>
            </div>
        }
        else
        {
            <div class="bg-slate-800 rounded-3xl p-8 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 border border-slate-700">
                <div>
                    <h3 class="text-2xl font-black">Partida Finalizada</h3>
                    <p class="text-slate-400 text-sm mt-1">Ganador: <span class="text-amber-400 font-bold">@Model.WinnerName</span></p>
                </div>
            </div>
        }

        <!-- ESTADÍSTICAS DEL COMBATE: DURACIÓN, MOVIMIENTOS, BARCOS HUNDIDOS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 text-brand-blue flex items-center justify-center text-2xl font-bold">
                    <i class="fas fa-stopwatch"></i>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Duración Total</p>
                    <p class="text-xl font-black text-gray-900 mt-0.5">
                        <span class="text-brand-blue font-black">@(totalHours) horas</span>
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl font-bold">
                    <i class="fas fa-crosshairs"></i>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Movimientos / Disparos</p>
                    <p class="text-xl font-black text-gray-900 mt-0.5">@attacks.Count() totales</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center text-2xl font-bold">
                    <i class="fas fa-fire"></i>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Barcos Hundidos</p>
                    <p class="text-xl font-black text-gray-900 mt-0.5">5/5</p>
                </div>
            </div>
        </div>

        <!-- VISUALIZACIÓN DE TABLEROS FINALES -->
        <div class="space-y-6">
            @{
                string effectiveMyId = (currentUserId == Model.Player1Id || currentUserId == Model.Player2Id) ? currentUserId : Model.Player1Id;
                string effectiveEnemyId = effectiveMyId == Model.Player1Id ? Model.Player2Id : Model.Player1Id;
                string myName = effectiveMyId == Model.Player1Id ? (Model.Player1Name ?? "Jugador 1") : (Model.Player2Name ?? "Jugador 2");
                string enemyName = effectiveMyId == Model.Player1Id ? (Model.Player2Name ?? "Jugador 2") : (Model.Player1Name ?? "Jugador 1");

                string currentMode = ViewBag.Mode as string ?? "";
                bool isPositioningMode = (currentMode == "positioning");

                string viewUserId = ViewBag.ViewBoardUserId as string ?? effectiveMyId;
                bool isViewingMyBoard = (viewUserId == effectiveMyId) && !isPositioningMode;
                bool isViewingEnemyBoard = (viewUserId == effectiveEnemyId) && !isPositioningMode;

                var myShipsList = ships.Where(s => s.UserId == effectiveMyId).ToList();
                var enemyShipsList = ships.Where(s => s.UserId == effectiveEnemyId).ToList();
                var myAttacksDict = attacks.Where(a => a.AttackerId == effectiveMyId).ToDictionary(a => $"{a.X},{a.Y}", a => a);
                var enemyAttacksDict = attacks.Where(a => a.AttackerId == effectiveEnemyId).ToDictionary(a => $"{a.X},{a.Y}", a => a);

                var myShipCells = new Dictionary<string, ShipPositionDTO>();
                foreach(var s in myShipsList) {
                    for(int i=0; i<s.ShipSize; i++) {
                        int x = s.StartX; int y = s.StartY;
                        if (s.Direction == ShipDirection.Up) y -= i;
                        else if (s.Direction == ShipDirection.Down) y += i;
                        else if (s.Direction == ShipDirection.Left) x -= i;
                        else if (s.Direction == ShipDirection.Right) x += i;
                        myShipCells[$"{x},{y}"] = s;
                    }
                }
                var enemyShipCells = new Dictionary<string, ShipPositionDTO>();
                foreach(var s in enemyShipsList) {
                    for(int i=0; i<s.ShipSize; i++) {
                        int x = s.StartX; int y = s.StartY;
                        if (s.Direction == ShipDirection.Up) y -= i;
                        else if (s.Direction == ShipDirection.Down) y += i;
                        else if (s.Direction == ShipDirection.Left) x -= i;
                        else if (s.Direction == ShipDirection.Right) x += i;
                        enemyShipCells[$"{x},{y}"] = s;
                    }
                }

                string activeAttackerName = isViewingMyBoard ? myName : enemyName;
                string activeDefenderName = isViewingMyBoard ? enemyName : myName;
                var activeAttacksDict = isViewingMyBoard ? myAttacksDict : enemyAttacksDict;
                var activeDefenderShips = isViewingMyBoard ? enemyShipsList : myShipsList;
                var activeDefenderShipCells = isViewingMyBoard ? enemyShipCells : myShipCells;
            }

            <div class="bg-white rounded-3xl shadow-xl border border-gray-200 p-6 sm:p-8 space-y-6 relative overflow-hidden animate-fade-in">
                <!-- Header of Board section with Switch Buttons -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100 pb-6">
                    <div>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl @(isPositioningMode ? "bg-indigo-50 text-indigo-600 border border-indigo-100" : isViewingMyBoard ? "bg-blue-50 text-brand-blue border border-blue-100" : "bg-purple-50 text-purple-600 border border-purple-100") flex items-center justify-center text-2xl shadow-sm">
                                <i class="fas @(isPositioningMode ? "fa-ship" : isViewingMyBoard ? "fa-crosshairs" : "fa-radar")"></i>
                            </div>
                            <div>
                                <span class="text-xs font-black uppercase tracking-wider @(isPositioningMode ? "text-indigo-600" : isViewingMyBoard ? "text-brand-blue" : "text-purple-600")">
                                    @(isPositioningMode ? "Tu Flota Naval" : isViewingMyBoard ? "Tu Desempeño en Batalla" : "Desempeño del Rival")
                                </span>
                                <h3 class="text-2xl font-black text-gray-900 tracking-tight">
                                    @(isPositioningMode ? "Mi Tablero de Posicionamiento" : $"Tablero de Ataque de {activeAttackerName}")
                                </h3>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 mt-1">
                            @(isPositioningMode ? "Ubicación de sus 5 barcos al inicio de la partida y ataques recibidos del rival." : $"Ataques realizados por {activeAttackerName} hacia la flota de {activeDefenderName} al finalizar la partida.")
                        </p>
                    </div>

                    <!-- Botones de Navegación de Tableros según pliego -->
                    <div class="flex items-center gap-2 self-start md:self-auto flex-wrap">
                        <a asp-action="Details" asp-route-id="@Model.Id" asp-route-viewBoardUserId="@effectiveMyId"
                           class="px-4 py-2.5 rounded-xl font-bold text-xs transition-all flex items-center gap-2 @(isViewingMyBoard ? "bg-brand-blue text-white shadow-md" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                            <i class="fas fa-crosshairs"></i> Ver mi tablero de ataque
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" asp-route-viewBoardUserId="@effectiveEnemyId"
                           class="px-4 py-2.5 rounded-xl font-bold text-xs transition-all flex items-center gap-2 @(isViewingEnemyBoard ? "bg-purple-600 text-white shadow-md" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                            <i class="fas fa-radar"></i> Ver tablero del otro jugador
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" asp-route-mode="positioning"
                           class="px-4 py-2.5 rounded-xl font-bold text-xs transition-all flex items-center gap-2 @(isPositioningMode ? "bg-indigo-600 text-white shadow-md" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                            <i class="fas fa-ship"></i> Ver tablero de posicionamiento
                        </a>
                    </div>
                </div>

                <!-- Mini Stats Bar for this board -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-gray-50 p-4 rounded-2xl border border-gray-200/60 text-center">
                    <div class="p-2">
                        <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block">Total Disparos</span>
                        <span class="text-xl font-black text-gray-800">@(isPositioningMode ? enemyAttacksDict.Count : activeAttacksDict.Count)</span>
                    </div>
                    <div class="p-2 border-l border-gray-200/60">
                        <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block">Impactos Acertados</span>
                        <span class="text-xl font-black text-red-600">@(isPositioningMode ? enemyAttacksDict.Values.Count(a => a.IsHit) : activeAttacksDict.Values.Count(a => a.IsHit))</span>
                    </div>
                    <div class="p-2 border-l border-gray-200/60">
                        <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block">Disparos Fallidos</span>
                        <span class="text-xl font-black text-emerald-600">@(isPositioningMode ? enemyAttacksDict.Values.Count(a => !a.IsHit) : activeAttacksDict.Values.Count(a => !a.IsHit))</span>
                    </div>
                    <div class="p-2 border-l border-gray-200/60">
                        <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block">Barcos Hundidos</span>
                        <span class="text-xl font-black text-amber-600">@(isPositioningMode ? myShipsList.Count(s => s.IsSunk) : activeDefenderShips.Count(s => s.IsSunk))/5</span>
                    </div>
                </div>

                <!-- The 12x12 Grid -->
                <div class="bg-slate-950 p-4 sm:p-6 rounded-3xl shadow-2xl border-4 border-slate-900 max-w-2xl mx-auto">
                    <div class="grid grid-cols-12 gap-1.5 aspect-square">
                        @for (int row = 0; row < 12; row++) {
                            for (int col = 0; col < 12; col++) {
                                string key = $"{col},{row}";
                                if (isPositioningMode)
                                {
                                    if (myShipCells.TryGetValue(key, out var myShip))
                                    {
                                        bool isHit = enemyAttacksDict.ContainsKey(key);
                                        if (isHit)
                                        {
                                            <div class="bg-red-600 text-white rounded-xl flex items-center justify-center border-2 border-red-500 shadow-lg title='Barco impactado en @((char)('A' + col))@(row + 1)'">
                                                <i class="fas fa-skull-crossbones text-sm sm:text-base md:text-lg"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="bg-brand-blue text-white rounded-xl flex items-center justify-center border-2 border-blue-400 shadow-md title='Tu barco en @((char)('A' + col))@(row + 1)'">
                                                <i class="fas fa-ship text-sm sm:text-base md:text-lg"></i>
                                            </div>
                                        }
                                    }
                                    else if (enemyAttacksDict.ContainsKey(key))
                                    {
                                        <div class="bg-emerald-600 text-white rounded-xl flex items-center justify-center border border-emerald-500 shadow-sm title='Disparo fallido del rival en @((char)('A' + col))@(row + 1)'">
                                            <i class="fas fa-tint text-sm sm:text-base md:text-lg"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-slate-900/90 border border-slate-800/80 rounded-xl flex items-center justify-center text-slate-700 title='Agua en @((char)('A' + col))@(row + 1)'">
                                            <i class="fas fa-water text-xs sm:text-sm opacity-20"></i>
                                        </div>
                                    }
                                }
                                else
                                {
                                    if (activeAttacksDict.TryGetValue(key, out var att)) {
                                        if (att.IsHit) {
                                            <div class="bg-red-600 text-white rounded-xl flex items-center justify-center border-2 border-red-500 shadow-lg animate-bounce title='Impacto en @((char)('A' + col))@(row + 1)'">
                                                <i class="fas fa-fire text-sm sm:text-base md:text-lg"></i>
                                            </div>
                                        } else {
                                            <div class="bg-emerald-600 text-white rounded-xl flex items-center justify-center border border-emerald-500 shadow-sm title='Agua / Fallo en @((char)('A' + col))@(row + 1)'">
                                                <i class="fas fa-tint text-sm sm:text-base md:text-lg"></i>
                                            </div>
                                        }
                                    } else if (activeDefenderShipCells.TryGetValue(key, out var defShip)) {
                                        <div class="bg-indigo-900/90 text-indigo-300 rounded-xl flex items-center justify-center border border-indigo-700 shadow-md title='Barco de @activeDefenderName en @((char)('A' + col))@(row + 1)'">
                                            <i class="fas fa-ship text-sm sm:text-base md:text-lg opacity-90"></i>
                                        </div>
                                    } else {
                                        <div class="bg-slate-900/90 border border-slate-800/80 rounded-xl flex items-center justify-center text-slate-700 title='Agua en @((char)('A' + col))@(row + 1)'">
                                            <i class="fas fa-water text-xs sm:text-sm opacity-20"></i>
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                </div>

                <!-- Legend -->
                <div class="flex items-center justify-center gap-6 text-xs sm:text-sm font-bold text-gray-700 pt-3 flex-wrap">
                    <div class="flex items-center gap-2 bg-red-50 px-3 py-1.5 rounded-xl border border-red-100">
                        <span class="w-5 h-5 rounded-lg bg-red-600 text-white flex items-center justify-center shadow-xs"><i class="fas fa-fire text-xs"></i></span>
                        <span>¡Impacto Acertado! (Rojo)</span>
                    </div>
                    <div class="flex items-center gap-2 bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-100">
                        <span class="w-5 h-5 rounded-lg bg-emerald-600 text-white flex items-center justify-center shadow-xs"><i class="fas fa-tint text-xs"></i></span>
                        <span>Disparo Fallido / Agua (Verde)</span>
                    </div>
                    <div class="flex items-center gap-2 bg-indigo-50 px-3 py-1.5 rounded-xl border border-indigo-100">
                        <span class="w-5 h-5 rounded-lg bg-indigo-900 text-indigo-300 flex items-center justify-center shadow-xs"><i class="fas fa-ship text-xs"></i></span>
                        <span>Posición de Barco</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Match Information Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 font-bold text-gray-800 flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fas fa-info-circle text-brand-blue"></i> Estado del Enfrentamiento</span>
            <span class="text-xs font-medium text-gray-500">ID Partida: #@Model.Id</span>
        </div>

        <div class="p-6">
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-6">
                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider">Turno Actual</dt>
                    <dd class="text-sm font-bold text-gray-800 mt-0.5 flex items-center gap-1.5">
                        @if (Model.Status == MatchStatus.InProgress)
                        {
                            <span class="w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
                        }
                        @(Model.CurrentTurnUserName ?? Model.CurrentTurnUserId)
                    </dd>
                </div>

                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider">Ganador de la Batalla</dt>
                    <dd class="text-sm font-bold text-gray-800 mt-0.5">
                        @if (!string.IsNullOrEmpty(Model.WinnerName))
                        {
                            <span class="text-amber-600 font-black flex items-center gap-1"><i class="fas fa-trophy"></i> @Model.WinnerName</span>
                        }
                        else
                        {
                            <span class="text-gray-400">En disputa / Pendiente</span>
                        }
                    </dd>
                </div>

                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider">Fecha de Asignación de Turno</dt>
                    <dd class="text-sm font-medium text-gray-700 mt-0.5">@Model.TurnAssignedAt.ToString("g")</dd>
                </div>

                <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <dt class="text-xs font-bold text-gray-400 uppercase tracking-wider">Fecha de Finalización</dt>
                    <dd class="text-sm font-medium text-gray-700 mt-0.5">@(Model.EndDate?.ToString("g") ?? "No finalizada")</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Actions Toolbar -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-3">
            @if (Model.Status == MatchStatus.Pending)
            {
                <a asp-controller="ShipPosition"
                   asp-action="PlaceShip"
                   asp-route-matchId="@Model.Id"
                   class="bg-brand-blue text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-blue-800 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                    <i class="fas fa-map-marker-alt"></i> Colocar Barcos
                </a>

                <a asp-controller="ShipPosition"
                   asp-action="MyShips"
                   asp-route-matchId="@Model.Id"
                   asp-route-playerId="@currentUserId"
                   class="bg-sky-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-sky-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                    <i class="fas fa-eye"></i> Ver Mis Barcos
                </a>

                <form asp-controller="ShipPosition"
                      asp-action="Ready"
                      method="post"
                      class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="matchId" value="@Model.Id" />
                    <button type="submit" class="bg-green-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-green-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                        <i class="fas fa-play"></i> ¡Estoy Listo! (Iniciar Partida)
                    </button>
                </form>
            }

            @if (Model.Status == MatchStatus.InProgress)
            {
                <a asp-controller="Attack"
                   asp-action="Play"
                   asp-route-matchId="@Model.Id"
                   class="bg-green-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-green-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2 animate-bounce">
                    <i class="fas fa-gamepad text-lg"></i> Entrar al Tablero de Juego
                </a>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="bg-blue-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-blue-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                    <i class="fas fa-sync-alt"></i> Refrescar pantalla
                </a>

                <form asp-action="Surrender"
                      method="post"
                      class="inline"
                      onsubmit="return confirm('¿Estás seguro de que deseas rendirte? Perderás automáticamente la partida.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="playerId" value="@currentUserId" />
                    <button type="submit" class="bg-red-500 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-red-600 transition-all shadow-sm hover:shadow-md flex items-center gap-2">
                        <i class="fas fa-flag"></i> Rendirse
                    </button>
                </form>
            }
        </div>

        <div>
            <a asp-action="Index" class="bg-gray-100 text-gray-700 px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors flex items-center gap-2">
                <i class="fas fa-arrow-left"></i> Volver atrás
            </a>
        </div>
    </div>
</div>
