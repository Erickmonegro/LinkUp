@using LinkUpPro.Core.Application.ViewModels.Battleship
@using LinkUpPro.Core.Domain.Common.Enums
@model IEnumerable<BattleshipMatchViewModel>

@{
    ViewData["Title"] = "Centro de Mando - Battleship";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var activeMatches = Model != null 
        ? Model.Where(m => m.Status != MatchStatus.Finished && m.Status != MatchStatus.Rejected).OrderByDescending(m => m.CreatedAt).ToList() 
        : new List<BattleshipMatchViewModel>();

    var historyMatches = Model != null 
        ? Model.Where(m => m.Status == MatchStatus.Finished || m.Status == MatchStatus.Rejected).OrderByDescending(m => m.EndDate ?? m.CreatedAt).ToList() 
        : new List<BattleshipMatchViewModel>();

    var finishedOnly = Model != null ? Model.Where(m => m.Status == MatchStatus.Finished).ToList() : new List<BattleshipMatchViewModel>();
    var totalPlayed = finishedOnly.Count;
    var totalWon = finishedOnly.Count(m => m.WinnerId == currentUserId);
    var totalLost = finishedOnly.Count(m => !string.IsNullOrEmpty(m.WinnerId) && m.WinnerId != currentUserId);
}

<div class="max-w-6xl mx-auto space-y-10 py-4">
    <!-- Header General -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-5">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue text-2xl shadow-sm">
                <i class="fas fa-water"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-gray-900 tracking-tight">Centro de Mando - Batalla Naval</h1>
                <p class="text-sm text-gray-500">Supervisa tus batallas navales en curso y consulta tu historial de enfrentamientos</p>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl flex items-center gap-2 text-sm font-medium shadow-2xs">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-2xl flex items-center gap-2 text-sm font-medium shadow-2xs">
            <i class="fas fa-info-circle text-blue-500 text-lg"></i>
            <span>@TempData["Info"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl flex items-center gap-2 text-sm font-medium shadow-2xs">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- 1. LISTADO DE PARTIDAS ACTIVAS -->
    <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gradient-to-r from-blue-900 via-brand-blue to-indigo-800 text-white p-5 rounded-3xl shadow-lg">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-xl backdrop-blur-xs">
                    <i class="fas fa-play-circle text-amber-400"></i>
                </div>
                <div>
                    <h2 class="text-lg font-black tracking-tight">Partidas Activas</h2>
                    <p class="text-xs text-blue-100">Enfrentamientos en curso y desafíos pendientes</p>
                </div>
            </div>
            <a asp-action="Create" class="bg-amber-400 hover:bg-amber-500 text-gray-950 font-black px-5 py-2.5 rounded-xl text-xs transition-all shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
                <i class="fas fa-plus-circle"></i> Iniciar nueva partida
            </a>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden">
            @if (!activeMatches.Any())
            {
                <div class="p-12 text-center space-y-3">
                    <div class="w-16 h-16 rounded-full bg-blue-50 flex items-center justify-center mx-auto text-brand-blue text-2xl">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <h3 class="font-bold text-gray-700">No tienes partidas activas en este momento</h3>
                    <p class="text-xs text-gray-400 max-w-sm mx-auto">¡Desafía a tus amigos a una batalla naval! No podrás retar a usuarios con los que ya estés jugando actualmente.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/80 border-b border-gray-200 text-gray-400 text-[11px] uppercase tracking-wider font-extrabold">
                                <th class="py-4 px-6">Contrincante / Amigo</th>
                                <th class="py-4 px-6">Estado</th>
                                <th class="py-4 px-6">Fecha de Inicio</th>
                                <th class="py-4 px-6">Tiempo Transcurrido</th>
                                <th class="py-4 px-6 text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm font-medium">
                            @foreach (var item in activeMatches)
                            {
                                var isMyTurn = item.CurrentTurnUserId == currentUserId && item.Status == MatchStatus.InProgress;
                                var opponentName = item.Player1Id == currentUserId ? (item.Player2Name ?? item.Player2Id) : (item.Player1Name ?? item.Player1Id);
                                var elapsedHours = Math.Max(0.1, Math.Round((DateTime.UtcNow - item.CreatedAt).TotalHours, 1));
                                
                                <tr class="hover:bg-blue-50/30 transition-colors @(isMyTurn ? "bg-amber-50/40" : "")">
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-brand-blue/10 text-brand-blue font-black flex items-center justify-center border border-blue-200">
                                                <i class="fas fa-user-shield"></i>
                                            </div>
                                            <div>
                                                <div class="font-black text-gray-900">@opponentName</div>
                                                <div class="text-[11px] text-gray-400">Partida #@item.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (item.Status == MatchStatus.ChallengePending)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800">
                                                <i class="fas fa-scroll animate-pulse"></i> Desafío Pendiente
                                            </span>
                                        }
                                        else if (item.Status == MatchStatus.Pending)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> Preparando Flota
                                            </span>
                                        }
                                        else if (item.Status == MatchStatus.InProgress)
                                        {
                                            @if (isMyTurn)
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 animate-pulse">
                                                    <i class="fas fa-star text-amber-500"></i> ¡Tu Turno!
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Turno Rival
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-gray-600 font-bold text-xs">
                                        <i class="far fa-calendar-alt text-gray-400 mr-1"></i>
                                        @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-800 px-2.5 py-1 rounded-lg text-xs font-bold">
                                            <i class="far fa-clock text-brand-blue"></i> @elapsedHours horas
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            @if (item.Status == MatchStatus.ChallengePending && item.Player2Id == currentUserId)
                                            {
                                                <form asp-action="AcceptChallenge" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="px-3 py-2 bg-green-600 text-white rounded-xl text-xs font-bold hover:bg-green-700 transition-colors inline-flex items-center gap-1 shadow-sm">
                                                        <i class="fas fa-check"></i> Aceptar
                                                    </button>
                                                </form>
                                                <form asp-action="RejectChallenge" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="px-3 py-2 bg-red-600 text-white rounded-xl text-xs font-bold hover:bg-red-700 transition-colors inline-flex items-center gap-1 shadow-sm">
                                                        <i class="fas fa-times"></i> Rechazar
                                                    </button>
                                                </form>
                                            }
                                            else if (item.Status == MatchStatus.InProgress && isMyTurn)
                                            {
                                                <a asp-controller="Attack" asp-action="Play" asp-route-matchId="@item.Id" class="px-3 py-2 bg-green-600 text-white rounded-xl text-xs font-bold hover:bg-green-700 transition-colors inline-flex items-center gap-1.5 shadow-sm">
                                                    <i class="fas fa-crosshairs"></i> Atacar
                                                </a>
                                            }
                                            
                                            <a asp-action="Details" asp-route-id="@item.Id" class="px-3 py-2 bg-brand-blue text-white rounded-xl text-xs font-bold hover:bg-blue-800 transition-all inline-flex items-center gap-1.5 shadow-sm">
                                                <i class="fas fa-gamepad"></i> Entrar a la partida
                                            </a>

                                            <a asp-action="SurrenderConfirm" asp-route-id="@item.Id" class="px-3 py-2 bg-red-50 text-red-600 border border-red-200 rounded-xl text-xs font-bold hover:bg-red-100 transition-all inline-flex items-center gap-1.5" title="Finalizar partida / Rendirse">
                                                <i class="fas fa-flag"></i> Finalizar partida
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- 2. LISTADO Y RESUMEN DEL HISTORIAL DE PARTIDAS -->
    <div class="space-y-6 pt-6 border-t border-gray-200">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl shadow-2xs">
                <i class="fas fa-history"></i>
            </div>
            <div>
                <h2 class="text-xl font-black text-gray-900 tracking-tight">Historial de Partidas</h2>
                <p class="text-xs text-gray-500">Resumen de rendimiento y registro completo de batallas finalizadas</p>
            </div>
        </div>

        <!-- Resumen de estadísticas del historial -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50/60 border border-blue-100 rounded-3xl p-6 flex items-center justify-between shadow-2xs">
                <div>
                    <p class="text-xs uppercase font-extrabold text-blue-600 tracking-wider">Total Partidas Jugadas</p>
                    <p class="text-3xl font-black text-gray-900 mt-1">@totalPlayed</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-600 flex items-center justify-center text-2xl shadow-inner">
                    <i class="fas fa-gamepad"></i>
                </div>
            </div>

            <div class="bg-gradient-to-br from-green-50 to-emerald-50/60 border border-green-100 rounded-3xl p-6 flex items-center justify-between shadow-2xs">
                <div>
                    <p class="text-xs uppercase font-extrabold text-green-600 tracking-wider">Partidas Ganadas</p>
                    <p class="text-3xl font-black text-gray-900 mt-1">@totalWon</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-green-500/10 text-green-600 flex items-center justify-center text-2xl shadow-inner">
                    <i class="fas fa-trophy"></i>
                </div>
            </div>

            <div class="bg-gradient-to-br from-red-50 to-rose-50/60 border border-red-100 rounded-3xl p-6 flex items-center justify-between shadow-2xs">
                <div>
                    <p class="text-xs uppercase font-extrabold text-red-600 tracking-wider">Partidas Perdidas</p>
                    <p class="text-3xl font-black text-gray-900 mt-1">@totalLost</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-red-500/10 text-red-600 flex items-center justify-center text-2xl shadow-inner">
                    <i class="fas fa-times-circle"></i>
                </div>
            </div>
        </div>

        <!-- Tabla del historial -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden">
            @if (!historyMatches.Any())
            {
                <div class="p-12 text-center space-y-2">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mx-auto text-gray-400 text-xl">
                        <i class="fas fa-archive"></i>
                    </div>
                    <h3 class="font-bold text-gray-700">Aún no tienes partidas en el historial</h3>
                    <p class="text-xs text-gray-400">Cuando termines una partida de Batalla Naval, aquí podrás consultar el resultado, duración y barcos hundidos.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/80 border-b border-gray-200 text-gray-400 text-[11px] uppercase tracking-wider font-extrabold">
                                <th class="py-4 px-6">Amigo con quien se jugó</th>
                                <th class="py-4 px-6">Fecha de inicio</th>
                                <th class="py-4 px-6">Fecha de finalización</th>
                                <th class="py-4 px-6">Duración total en horas</th>
                                <th class="py-4 px-6">Resultado</th>
                                <th class="py-4 px-6">Ganador</th>
                                <th class="py-4 px-6 text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm font-medium">
                            @foreach (var item in historyMatches)
                            {
                                var isWinner = item.WinnerId == currentUserId;
                                var isRejected = item.Status == MatchStatus.Rejected;
                                var opponentName = item.Player1Id == currentUserId ? (item.Player2Name ?? item.Player2Id) : (item.Player1Name ?? item.Player1Id);
                                var durationHours = Math.Max(0, Math.Round(((item.EndDate ?? DateTime.UtcNow) - item.CreatedAt).TotalHours, 1));
                                
                                <tr class="hover:bg-gray-50/60 transition-colors">
                                    <td class="py-4 px-6 font-bold text-gray-800">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full bg-brand-blue/10 text-brand-blue flex items-center justify-center font-bold text-xs">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <span>@opponentName</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600 font-bold text-xs">
                                        <i class="far fa-calendar-alt text-gray-400 mr-1"></i>
                                        @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-4 px-6 text-gray-600 font-bold text-xs">
                                        <i class="far fa-calendar-check text-gray-400 mr-1"></i>
                                        @(item.EndDate.HasValue ? item.EndDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-800 px-2.5 py-1 rounded-lg text-xs font-bold">
                                            <i class="far fa-clock text-brand-blue"></i> @durationHours horas
                                        </span>
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (isRejected)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600">
                                                <i class="fas fa-ban text-gray-400"></i> Rechazada
                                            </span>
                                        }
                                        else if (isWinner)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                                <i class="fas fa-trophy text-amber-500"></i> Ganada
                                            </span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.WinnerId))
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">
                                                <i class="fas fa-times text-red-500"></i> Perdida
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-700">
                                                Finalizada
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (isWinner)
                                        {
                                            <span class="text-amber-600 font-black inline-flex items-center gap-1.5">
                                                <i class="fas fa-trophy text-amber-500"></i> Yo
                                            </span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.WinnerId))
                                        {
                                            <span class="text-gray-900 font-bold inline-flex items-center gap-1.5">
                                                <i class="fas fa-award text-gray-400"></i> @opponentName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">-</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="px-3.5 py-2 bg-brand-blue/10 text-brand-blue rounded-xl text-xs font-bold hover:bg-brand-blue hover:text-white transition-all inline-flex items-center gap-1.5 shadow-2xs">
                                            <i class="fas fa-chart-bar"></i> Ver resultado
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
