@model LinkUpPro.Core.Application.ViewModels.FriendRequest.FriendRequestListViewModel
@{
    ViewData["Title"] = "Solicitudes de Amistad";
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm flex items-center gap-2">
            <i class="fas fa-check-circle text-green-500"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm">
            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-6">
        <div class="flex justify-between items-center">
            <h1 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                <i class="fas fa-envelope-open-text text-brand-blue"></i> Solicitudes de Amistad
            </h1>
            <a asp-action="New" class="bg-brand-blue text-white px-4 py-2 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-sm text-sm">
                <i class="fas fa-user-plus mr-1"></i> Nueva solicitud de amistad
            </a>
        </div>

        <!-- Tabs -->
        <div class="border-b border-gray-200">
            <nav class="flex gap-6" aria-label="Tabs">
                <button onclick="showTab('received')" id="tab-received" class="border-brand-blue text-brand-blue border-b-2 py-4 px-1 font-bold text-sm flex items-center gap-1.5 focus:outline-none">
                    Solicitudes pendientes de responder
                    @if (Model.PendingCount > 0)
                    {
                        <span class="bg-red-500 text-white rounded-full text-[10px] px-1.5 py-0.5 font-bold">
                            @Model.PendingCount
                        </span>
                    }
                </button>
                <button onclick="showTab('sent')" id="tab-sent" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 font-bold text-sm focus:outline-none">
                    Solicitudes enviadas
                </button>
            </nav>
        </div>

        <!-- 1. Received Requests Tab -->
        <div id="content-received" class="space-y-4">
            @if (Model.ReceivedRequests == null || !Model.ReceivedRequests.Any())
            {
                <p class="text-gray-500 text-center py-8">No tiene solicitudes de amistad pendientes de responder.</p>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var req in Model.ReceivedRequests)
                    {
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between py-4 gap-4">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(req.SenderProfilePhoto))
                                {
                                    <img src="@req.SenderProfilePhoto" alt="" class="w-12 h-12 rounded-full object-cover border border-gray-200" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                        <i class="fas fa-user text-xl"></i>
                                    </div>
                                }
                                <div>
                                    <h4 class="font-bold text-gray-900">@req.SenderName</h4>
                                    <p class="text-xs text-gray-400">&#64;@(req.SenderUserName ?? req.SenderName)</p>
                                    <span class="text-[10px] bg-blue-50 text-brand-blue font-bold px-1.5 py-0.5 rounded mt-0.5 inline-block">
                                        @req.MutualFriendsCount amigo@(req.MutualFriendsCount != 1 ? "s" : "") en común
                                    </span>
                                    <p class="text-xs text-gray-500 mt-1">Enviada: @req.CreatedAt.ToLocalTime().ToString("g")</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <form asp-action="Accept" method="post" onsubmit="return confirm('¿Está seguro que desea aceptar la solicitud de amistad del usuario @(req.SenderUserName ?? req.SenderName)?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="bg-brand-blue text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-blue-800 transition-colors shadow-sm flex items-center gap-1">
                                        <i class="fas fa-check"></i> Aceptar
                                    </button>
                                </form>

                                <form asp-action="Reject" method="post" onsubmit="return confirm('¿Está seguro que desea rechazar la solicitud de amistad del usuario @(req.SenderUserName ?? req.SenderName)?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-xs font-bold hover:bg-gray-200 transition-colors flex items-center gap-1">
                                        <i class="fas fa-times"></i> Rechazar
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 2. Sent Requests Tab -->
        <div id="content-sent" class="space-y-4 hidden">
            @if (Model.SentRequests == null || !Model.SentRequests.Any())
            {
                <p class="text-gray-500 text-center py-8">No ha enviado solicitudes de amistad.</p>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var req in Model.SentRequests)
                    {
                        var isPending = req.Status == "Pending";
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between py-4 gap-4">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(req.ReceiverProfilePhoto))
                                {
                                    <img src="@req.ReceiverProfilePhoto" alt="" class="w-12 h-12 rounded-full object-cover border border-gray-200" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                        <i class="fas fa-user text-xl"></i>
                                    </div>
                                }
                                <div>
                                    <h4 class="font-bold text-gray-900">@req.ReceiverName</h4>
                                    <p class="text-xs text-gray-400">&#64;@(req.ReceiverUserName ?? req.ReceiverName)</p>
                                    <span class="text-[10px] bg-blue-50 text-brand-blue font-bold px-1.5 py-0.5 rounded mt-0.5 inline-block">
                                        @req.MutualFriendsCount amigo@(req.MutualFriendsCount != 1 ? "s" : "") en común
                                    </span>
                                    <p class="text-xs text-gray-500 mt-1">
                                        Estado: 
                                        @if (isPending)
                                        {
                                            <span class="text-yellow-600 bg-yellow-50 px-2 py-0.5 rounded-full font-bold">En espera de respuesta</span>
                                        }
                                        else if (req.Status == "Accepted")
                                        {
                                            <span class="text-green-600 bg-green-50 px-2 py-0.5 rounded-full font-bold">Aceptada</span>
                                        }
                                        else
                                        {
                                            <span class="text-red-600 bg-red-50 px-2 py-0.5 rounded-full font-bold">Rechazada</span>
                                        }
                                    </p>
                                    @if (req.RespondedAt.HasValue)
                                    {
                                        <p class="text-[10px] text-gray-400 mt-0.5">Respuesta: @req.RespondedAt.Value.ToLocalTime().ToString("g")</p>
                                    }
                                </div>
                            </div>

                            <div>
                                @if (isPending)
                                {
                                    <form asp-action="Cancel" method="post" onsubmit="return confirm('¿Está seguro que desea cancelar la solicitud de amistad enviada a @(req.ReceiverUserName ?? req.ReceiverName)?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@req.Id" />
                                        <button type="submit" class="bg-red-50 text-red-600 border border-red-100 px-4 py-2 rounded-lg text-xs font-bold hover:bg-red-100 transition-colors">
                                            Cancelar solicitud
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" onclick="openDeleteHistoryModal(@req.Id)" class="bg-gray-100 hover:bg-red-50 text-gray-700 hover:text-red-600 border border-gray-200 hover:border-red-200 px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs">
                                        <i class="fas fa-trash-alt"></i> Eliminar del historial
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Modal Confirmación Eliminar del Historial -->
        <div id="deleteHistoryModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/50 backdrop-blur-xs transition-opacity">
            <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 p-6 max-w-md w-full mx-4 transform transition-all space-y-5 text-center">
                <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-xl shadow-inner">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                
                <div class="space-y-2">
                    <h3 class="text-base font-bold text-gray-900">¿Está seguro que desea eliminar esta solicitud de su historial?</h3>
                </div>
                
                <form id="deleteHistoryForm" asp-action="Hide" method="post" class="flex items-center justify-center gap-3 pt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteHistoryRequestId" value="" />
                    
                    <button type="button" onclick="closeDeleteHistoryModal()" class="flex-1 bg-gray-100 text-gray-700 px-4 py-2.5 rounded-xl text-xs font-bold hover:bg-gray-200 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="flex-1 bg-red-600 text-white px-4 py-2.5 rounded-xl text-xs font-bold hover:bg-red-700 transition-colors shadow-sm flex items-center justify-center gap-1">
                        <i class="fas fa-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function showTab(tabName) {
            const receivedTab = document.getElementById('tab-received');
            const sentTab = document.getElementById('tab-sent');
            const receivedContent = document.getElementById('content-received');
            const sentContent = document.getElementById('content-sent');

            if (tabName === 'received') {
                receivedTab.className = "border-brand-blue text-brand-blue border-b-2 py-4 px-1 font-bold text-sm flex items-center gap-1.5 focus:outline-none";
                sentTab.className = "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 font-bold text-sm focus:outline-none";
                receivedContent.classList.remove('hidden');
                sentContent.classList.add('hidden');
            } else {
                sentTab.className = "border-brand-blue text-brand-blue border-b-2 py-4 px-1 font-bold text-sm flex items-center gap-1.5 focus:outline-none";
                receivedTab.className = "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 font-bold text-sm focus:outline-none";
                sentContent.classList.remove('hidden');
                receivedContent.classList.add('hidden');
            }
        }

        function openDeleteHistoryModal(id) {
            document.getElementById('deleteHistoryRequestId').value = id;
            document.getElementById('deleteHistoryModal').classList.remove('hidden');
        }

        function closeDeleteHistoryModal() {
            document.getElementById('deleteHistoryModal').classList.add('hidden');
        }
    </script>
}
