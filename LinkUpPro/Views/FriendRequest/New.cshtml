@model LinkUpPro.Core.Application.ViewModels.FriendRequest.SendRequestViewModel
@{
    ViewData["Title"] = "Buscar Amigos";
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Back to Requests -->
    <div class="flex justify-start">
        <a asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium flex items-center gap-1.5 transition-colors">
            <i class="fas fa-arrow-left"></i> Volver a Solicitudes
        </a>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-6">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <i class="fas fa-search text-brand-blue"></i> Buscar Usuarios de LinkUp Pro
        </h2>

        <form asp-action="New" method="get" class="flex gap-2">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Buscar por nombre, apellido o usuario..."
                class="flex-grow px-4 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all" />
            <button type="submit" class="bg-brand-blue text-white px-5 py-2 rounded-xl text-sm font-bold hover:bg-blue-800 transition-colors shadow-sm flex items-center gap-1.5">
                <i class="fas fa-search"></i> Buscar
            </button>
        </form>

        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <form asp-action="Send" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SearchTerm" />

            @if (Model.AvailableUsers == null || !Model.AvailableUsers.Any())
            {
                <div class="text-center py-8 text-gray-500 border border-dashed border-gray-200 rounded-xl">
                    <i class="fas fa-user-slash text-4xl mb-2 text-gray-300"></i>
                    <p class="font-medium">No se encontraron usuarios elegibles.</p>
                </div>
            }
            else
            {
                <div class="border border-gray-100 rounded-xl overflow-hidden divide-y divide-gray-100">
                    @foreach (var user in Model.AvailableUsers)
                    {
                        <label class="flex items-center justify-between p-4 hover:bg-gray-50/50 cursor-pointer transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="radio" asp-for="SelectedUserId" value="@user.UserId" class="w-4 h-4 text-brand-blue border-gray-300 focus:ring-brand-blue" />
                                
                                @if (!string.IsNullOrEmpty(user.ProfilePhoto))
                                {
                                    <img src="@user.ProfilePhoto" alt="" class="w-10 h-10 rounded-full object-cover border border-gray-200" />
                                }
                                else
                                {
                                    <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                        <i class="fas fa-user text-lg"></i>
                                    </div>
                                }

                                <div>
                                    <h4 class="font-bold text-gray-900 text-sm">@user.FullName</h4>
                                    <p class="text-xs text-gray-400">@@@user.UserName</p>
                                </div>
                            </div>
                        </label>
                    }
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="bg-brand-blue text-white px-6 py-2.5 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-md flex items-center gap-1.5">
                        <i class="fas fa-paper-plane"></i> Enviar Solicitud
                    </button>
                </div>
            }
        </form>
    </div>
</div>
