@using LinkUpPro.Core.Domain.Common.Enums
@using System.Security.Claims
@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendListViewModel
@{
    ViewData["Title"] = "Mis Amigos";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="max-w-7xl mx-auto space-y-6">

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm flex items-center gap-2">
            <i class="fas fa-check-circle text-green-500"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm">
            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (ViewBag.DateFrom != null && ViewBag.DateTo != null && DateTime.Parse(ViewBag.DateFrom.ToString()) > DateTime.Parse(ViewBag.DateTo.ToString()))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-4">
            <i class="fas fa-exclamation-circle mr-1"></i> La fecha inicial (Desde) no puede ser posterior a la fecha final (Hasta).
        </div>
    }

    <!-- 1. Resumen de Amistades -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200 flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-brand-blue text-xl">
                <i class="fas fa-user-friends"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total de Amigos</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.ActiveFriendsCount</h3>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200 flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 text-xl">
                <i class="fas fa-newspaper"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Publicaciones de Amigos</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.FriendPostsCount</h3>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: List of Friends & Navigation -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-4">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <i class="fas fa-users text-brand-blue"></i> Mis Amigos
                    </h2>
                    <a asp-controller="FriendRequest" asp-action="New" class="text-xs bg-brand-blue text-white px-3 py-1.5 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-sm">
                        <i class="fas fa-plus"></i> Buscar
                    </a>
                </div>

                @if (Model.Friends == null || !Model.Friends.Any())
                {
                    <p class="text-sm text-gray-500 text-center py-4">No tienes amigos agregados aún.</p>
                }
                else
                {
                    <div class="divide-y divide-gray-100 max-h-[450px] overflow-y-auto pr-1">
                        @foreach (var friend in Model.Friends)
                        {
                            <div class="flex items-center justify-between py-3">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(friend.ProfilePhoto))
                                    {
                                        <img src="@friend.ProfilePhoto" alt="" class="w-10 h-10 rounded-full object-cover border border-gray-200" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }
                                    <div>
                                        <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@friend.UserId" class="font-bold text-sm text-gray-900 hover:text-brand-blue transition-colors hover:underline">
                                            @friend.FullName
                                        </a>
                                        <p class="text-xs text-gray-400">&#64;@friend.UserName</p>
                                        <span class="text-[10px] bg-blue-50 text-brand-blue font-bold px-1.5 py-0.5 rounded mt-0.5 inline-block">
                                            @friend.MutualFriendsCount amigos en común
                                        </span>
                                    </div>
                                </div>

                                <form asp-controller="Friendship" asp-action="Delete" method="post" onsubmit="return confirm('¿Está seguro de eliminar esta amistad? Ambas partes dejarán de ver sus publicaciones.');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="friendshipId" value="@friend.Id" />
                                    <button type="submit" class="text-gray-400 hover:text-red-500 p-2 rounded-lg hover:bg-red-50 transition-colors" title="Eliminar Amigo">
                                        <i class="fas fa-user-minus"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Buscador + Feed of Friends Posts -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Buscador y Filtros -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <i class="fas fa-search text-brand-blue"></i> Filtrar Feed de Amigos
                </h2>
                <form asp-controller="Friendship" asp-action="Index" method="get" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Text -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Buscar texto</label>
                            <input type="text" name="textFilter" value="@ViewBag.TextFilter"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all"
                                placeholder="Contenido..." />
                        </div>

                        <!-- Friend dropdown -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Por Amigo</label>
                            <select name="friendIdFilter"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all">
                                <option value="">Todos los amigos</option>
                                @foreach (var friend in Model.Friends)
                                {
                                    <option value="@friend.UserId" selected="@(ViewBag.FriendIdFilter == friend.UserId)">@friend.FullName</option>
                                }
                            </select>
                        </div>

                        <!-- Content Type -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Tipo de Contenido</label>
                            <select name="contentTypeFilter"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all">
                                <option value="@((int)ContentType.All)" selected="@(ViewBag.ContentTypeFilter == (int)ContentType.All)">Todos</option>
                                <option value="@((int)ContentType.Image)" selected="@(ViewBag.ContentTypeFilter == (int)ContentType.Image)">Imagen</option>
                                <option value="@((int)ContentType.YouTubeVideo)" selected="@(ViewBag.ContentTypeFilter == (int)ContentType.YouTubeVideo)">Video de YouTube</option>
                            </select>
                        </div>

                        <!-- Edition status -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Estado de Edición</label>
                            <select name="editionStatusFilter"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all">
                                <option value="@((int)EditionStatus.All)" selected="@(ViewBag.EditionStatusFilter == (int)EditionStatus.All)">Todas</option>
                                <option value="@((int)EditionStatus.Edited)" selected="@(ViewBag.EditionStatusFilter == (int)EditionStatus.Edited)">Editadas</option>
                                <option value="@((int)EditionStatus.NotEdited)" selected="@(ViewBag.EditionStatusFilter == (int)EditionStatus.NotEdited)">No editadas</option>
                            </select>
                        </div>

                        <!-- Date From -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Fecha Desde</label>
                            <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all" />
                        </div>

                        <!-- Date To -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Fecha Hasta</label>
                            <input type="date" name="dateTo" value="@ViewBag.DateTo"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none text-sm transition-all" />
                        </div>
                    </div>

                    <div class="flex justify-end gap-2">
                        <a asp-controller="Friendship" asp-action="Index" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-bold hover:bg-gray-300 transition-colors text-sm">
                            Limpiar
                        </a>
                        <button type="submit" class="bg-brand-blue text-white px-5 py-2 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-sm text-sm">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div>
                </form>
            </div>

            <!-- Feed list -->
            <div class="space-y-6">
                @if (Model.Posts == null || !Model.Posts.Any())
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center">
                        <i class="far fa-folder-open text-gray-400 text-4xl mb-3"></i>
                        <p class="text-gray-500 font-medium">@(!string.IsNullOrEmpty(ViewBag.TextFilter) || !string.IsNullOrEmpty(ViewBag.FriendIdFilter) || ViewBag.DateFrom != null || ViewBag.DateTo != null || (ViewBag.ContentTypeFilter != null && ViewBag.ContentTypeFilter != 1) || (ViewBag.EditionStatusFilter != null && ViewBag.EditionStatusFilter != 1) ? "No se encontraron publicaciones que coincidan con los criterios seleccionados." : "No se encontraron publicaciones de amigos.")</p>
                    </div>
                }
                else
                {
                    foreach (var post in Model.Posts)
                    {
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-4">
                            <!-- Header -->
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(post.AuthorPhotoUrl))
                                {
                                    <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@post.AuthorId" class="flex-shrink-0">
                                        <img src="@post.AuthorPhotoUrl" alt="" class="w-10 h-10 rounded-full object-cover border border-gray-200 hover:ring-2 hover:ring-brand-blue transition-all" />
                                    </a>
                                }
                                else
                                {
                                    <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                        <i class="fas fa-user"></i>
                                    </div>
                                }
                                <div>
                                    <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@post.AuthorId" class="font-bold text-gray-900 leading-tight hover:text-brand-blue transition-colors">@post.AuthorName</a>
                                    <div class="flex items-center gap-2 text-xs text-gray-400 mt-0.5">
                                        <span>@post.Created.ToLocalTime().ToString("g")</span>
                                        @if (post.EditionStatus == EditionStatus.Edited)
                                        {
                                            <span>•</span>
                                            <span class="bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded text-[10px] font-bold">Editada</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Text Content -->
                            <p class="text-gray-800 leading-relaxed whitespace-pre-line">@post.TextContent</p>

                            <!-- Media -->
                            @if (post.ContentType == ContentType.Image && !string.IsNullOrEmpty(post.MediaUrl))
                            {
                                <div class="rounded-xl overflow-hidden border border-gray-100 max-h-[450px]">
                                    <img src="@post.MediaUrl" alt="" class="w-full h-full object-cover" />
                                </div>
                            }
                            else if (post.ContentType == ContentType.YouTubeVideo && !string.IsNullOrEmpty(post.MediaUrl))
                            {
                                <div class="aspect-video rounded-xl overflow-hidden border border-gray-100 bg-black">
                                    <iframe src="@post.MediaUrl" class="w-full h-full" frameborder="0" allowfullscreen
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                </div>
                            }

                            <hr class="border-gray-100" />

                            <!-- Reactions and counts -->
                            <div class="flex items-center justify-between text-sm text-gray-500 font-medium">
                                <div class="flex items-center gap-4">
                                    @{
                                        var userReaction = post.Reactions?.FirstOrDefault(r => r.UserId == userId);
                                        var hasLike = userReaction != null && userReaction.ReactionType == ReactionType.Like;
                                        var hasDislike = userReaction != null && userReaction.ReactionType == ReactionType.Dislike;
                                    }
                                    <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <input type="hidden" name="isLike" value="true" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString())" />
                                        <button type="submit" class="flex items-center gap-1.5 hover:text-brand-blue transition-colors @(hasLike ? "text-brand-blue font-bold" : "")">
                                            <i class="@(hasLike ? "fas" : "far") fa-thumbs-up"></i>
                                            <span>@post.LikesCount</span>
                                        </button>
                                    </form>

                                    <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <input type="hidden" name="isLike" value="false" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString())" />
                                        <button type="submit" class="flex items-center gap-1.5 hover:text-red-500 transition-colors @(hasDislike ? "text-red-500 font-bold" : "")">
                                            <i class="@(hasDislike ? "fas" : "far") fa-thumbs-down"></i>
                                            @if (post.DislikesCount > 0)
                                            {
                                                <span class="text-[11px]">@post.DislikesCount</span>
                                            }
                                        </button>
                                    </form>
                                    
                                    @if (userReaction != null)
                                    {
                                        <span class="text-xs text-gray-400">
                                            Tu reacción: @(userReaction.ReactionType == ReactionType.Like ? "Me gusta" : "No me gusta")
                                        </span>
                                    }
                                </div>

                                <div class="flex items-center gap-1.5">
                                    <i class="far fa-message"></i>
                                    <span>@post.CommentsCount comentarios</span>
                                </div>
                            </div>

                            <!-- Comment/Reply List (Reuses the nested display from Home/Index) -->
                            <div class="pt-4 border-t border-gray-100 space-y-4">
                                @if (post.Comments != null && post.Comments.Any())
                                {
                                    <div class="space-y-4 max-h-[250px] overflow-y-auto pr-2">
                                        @{
                                            async Task RenderFriendPostCommentsAsync(IEnumerable<LinkUpPro.Core.Application.DTOs.CommentDTO.CommentDTO> comments, int depth = 0)
                                            {
                                                var commentsToRender = depth == 0 ? comments.Where(c => c.ParentCommentId == null || c.ParentCommentId == 0) : comments;
                                                foreach (var comment in commentsToRender)
                                                {
                                                    var isMyComment = comment.AuthorId == userId;
                                                    var isDeletedPlaceholder = comment.Content == "Este comentario fue eliminado." || comment.Content == "comentario eliminado" || comment.Content == "Comentario eliminado";
                                                    
                                                    <div class="bg-gray-50/70 p-3 rounded-xl border border-gray-100 relative @(depth > 0 ? "ml-8 border-l-2 border-brand-blue/20" : "")">
                                                        <div class="flex justify-between items-start">
                                                            <div class="flex items-center gap-2">
                                                                @if (!isDeletedPlaceholder && !string.IsNullOrEmpty(comment.AuthorPhotoUrl))
                                                                {
                                                                    <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@comment.AuthorId" class="flex-shrink-0">
                                                                        <img src="@comment.AuthorPhotoUrl" alt="" class="w-6 h-6 rounded-full object-cover hover:ring-2 hover:ring-brand-blue transition-all" />
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-gray-400">
                                                                        <i class="fas fa-user text-xs"></i>
                                                                    </div>
                                                                }
                                                                @if (!isDeletedPlaceholder)
                                                                {
                                                                    <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@comment.AuthorId" class="font-bold text-xs text-gray-800 hover:text-brand-blue transition-colors">
                                                                        @comment.AuthorName
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="font-bold text-xs text-gray-800">[Eliminado]</span>
                                                                }
                                                                <span class="text-[10px] text-gray-400">
                                                                    @comment.Created.ToLocalTime().ToString("g")
                                                                    @if (comment.IsEdited && !isDeletedPlaceholder)
                                                                    {
                                                                        <span class="bg-blue-50 text-brand-blue px-1.5 py-0.5 rounded text-[9px] font-extrabold border border-blue-100 ml-1">Editado</span>
                                                                    }
                                                                </span>
                                                            </div>

                                                            @if (isMyComment && !isDeletedPlaceholder)
                                                            {
                                                                <div class="flex items-center gap-1">
                                                                    <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="text-gray-400 hover:text-brand-blue text-xs p-1">
                                                                        <i class="fas fa-edit"></i>
                                                                    </button>
                                                                    <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" onsubmit="return confirm('¿Está seguro de eliminar este comentario?');" class="inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="text-gray-400 hover:text-red-500 text-xs p-1">
                                                                            <i class="fas fa-trash-alt"></i>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            }
                                                        </div>

                                                        <!-- Content -->
                                                        <div class="mt-2 text-sm text-gray-700">
                                                            <p id="commentContent-@comment.Id">
                                                                @comment.Content
                                                                @if (comment.IsEdited)
                                                                {
                                                                    <span class="text-[11px] text-gray-400 font-normal italic ml-1">(editado)</span>
                                                                }
                                                            </p>
                                                            
                                                            <form id="commentEditForm-@comment.Id" asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id" method="post" class="hidden mt-2 space-y-2">
                                                                @Html.AntiForgeryToken()
                                                                <input type="text" name="content" value="@comment.Content" required class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-md focus:ring-1 focus:ring-brand-blue outline-none" />
                                                                <div class="flex justify-end gap-1.5">
                                                                    <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="px-2.5 py-1 text-[10px] font-bold bg-gray-200 text-gray-600 rounded">Cancelar</button>
                                                                    <button type="submit" class="px-2.5 py-1 text-[10px] font-bold bg-brand-blue text-white rounded hover:bg-blue-800">Guardar</button>
                                                                </div>
                                                            </form>
                                                        </div>

                                                        <!-- Reply button -->
                                                        @if (post.CommentStatus == CommentStatus.Allowed && !isDeletedPlaceholder)
                                                        {
                                                            <div class="mt-2 flex justify-start">
                                                                <button type="button" onclick="toggleReplyForm(@comment.Id)" class="text-xs text-brand-blue hover:underline font-semibold flex items-center gap-1">
                                                                    <i class="fas fa-reply"></i> Responder
                                                                </button>
                                                            </div>

                                                            <!-- Reply Form -->
                                                            <form id="replyForm-@comment.Id" asp-controller="Comment" asp-action="Create" method="post" class="hidden mt-2 space-y-2">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="PostId" value="@post.Id" />
                                                                <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                                                <input type="text" name="Content" required maxlength="500" placeholder="Escribe una respuesta..."
                                                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-brand-blue outline-none" />
                                                                <div class="flex justify-end gap-1.5">
                                                                    <button type="button" onclick="toggleReplyForm(@comment.Id)" class="px-3 py-1 bg-gray-200 text-gray-600 rounded-md text-xs font-bold">Cancelar</button>
                                                                    <button type="submit" class="bg-brand-blue text-white px-3 py-1 rounded-md text-xs font-bold hover:bg-blue-800">Enviar</button>
                                                                </div>
                                                            </form>
                                                        }
                                                    </div>

                                                    if (comment.Replies != null && comment.Replies.Any())
                                                    {
                                                        await RenderFriendPostCommentsAsync(comment.Replies, depth + 1);
                                                    }
                                                }
                                            }

                                            await RenderFriendPostCommentsAsync(post.Comments);
                                        }
                                    </div>
                                }

                                <!-- Add comment -->
                                @if (post.CommentStatus == CommentStatus.Allowed)
                                {
                                    <form asp-controller="Comment" asp-action="Create" method="post" class="flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PostId" value="@post.Id" />
                                        <input type="text" name="Content" required maxlength="500" placeholder="Escribe un comentario..."
                                            class="flex-grow px-4 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all" />
                                        <button type="submit" class="bg-brand-blue text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-blue-800 transition-colors shadow-sm">
                                            Comentar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="bg-gray-50 border border-gray-200 text-gray-500 rounded-xl p-3 text-center text-xs font-medium">
                                        <i class="fas fa-comment-slash mr-1"></i> Los comentarios están desactivados para esta publicación.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleReplyForm(commentId) {
            const form = document.getElementById('replyForm-' + commentId);
            form.classList.toggle('hidden');
        }

        function toggleCommentEditForm(commentId) {
            const text = document.getElementById('commentContent-' + commentId);
            const form = document.getElementById('commentEditForm-' + commentId);
            text.classList.toggle('hidden');
            form.classList.toggle('hidden');
        }
    </script>
}
