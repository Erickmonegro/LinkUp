@using LinkUpPro.Core.Domain.Common.Enums
@using System.Security.Claims
@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendProfileViewModel
@{
    ViewData["Title"] = $"Perfil de {Model.FullName}";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var posts = ViewBag.Posts as List<LinkUpPro.Core.Application.DTOs.PostDTO.PostDTO> ?? new List<LinkUpPro.Core.Application.DTOs.PostDTO.PostDTO>();
}

<div class="max-w-5xl mx-auto space-y-0">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- HERO: Cover Photo + Profile Info Card              -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="bg-white rounded-3xl shadow-lg border border-gray-200/70 overflow-hidden">

        <!-- Cover Photo -->
        <div class="relative h-52 sm:h-72">
            @if (!string.IsNullOrEmpty(Model.CoverPhoto))
            {
                <img src="@Model.CoverPhoto" alt="Portada" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            }
            else
            {
                <div class="w-full h-full bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 relative overflow-hidden">
                    <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
                    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="absolute -left-10 -top-10 w-64 h-64 bg-white/10 rounded-full blur-2xl"></div>
                </div>
            }

            <!-- Back button -->
            <div class="absolute top-4 left-4 z-10">
                <a asp-controller="Friendship" asp-action="Index"
                   class="inline-flex items-center gap-2 bg-black/40 hover:bg-black/60 backdrop-blur-sm text-white text-sm font-semibold px-4 py-2 rounded-full border border-white/20 transition-all shadow-lg">
                    <i class="fas fa-arrow-left text-xs"></i> Volver atrás
                </a>
            </div>
        </div>

        <!-- Profile Info Row -->
        <div class="relative px-6 pb-6">
            <!-- Avatar (overlapping) -->
            <div class="flex flex-col sm:flex-row sm:items-end gap-4 -mt-14 sm:-mt-16">
                <div class="relative flex-shrink-0">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
                    {
                        <img src="@Model.ProfilePhoto" alt="@Model.FullName"
                             class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-4 border-white shadow-xl" />
                    }
                    else
                    {
                        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 border-4 border-white shadow-xl flex items-center justify-center">
                            <span class="text-4xl font-black text-white">@(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")</span>
                        </div>
                    }
                    <span class="absolute -bottom-1.5 -right-1.5 w-5 h-5 bg-emerald-400 border-2 border-white rounded-full shadow"></span>
                </div>

                <!-- Name + Stats + Actions -->
                <div class="flex-grow flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-1">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 leading-tight">@Model.FullName</h1>
                        <p class="text-sm text-gray-500 font-medium mt-0.5">&#64;@Model.UserName</p>

                        <!-- Stats badges -->
                        <div class="flex flex-wrap gap-2 mt-3">
                            <span class="inline-flex items-center gap-1.5 bg-blue-50 text-brand-blue text-xs font-bold px-3 py-1.5 rounded-full border border-blue-100">
                                <i class="fas fa-users text-[10px]"></i>
                                @Model.TotalFriends amigo@(Model.TotalFriends != 1 ? "s" : "")
                            </span>
                            @if (Model.MutualFriendsCount > 0)
                            {
                                <button type="button" onclick="openMutualFriendsModal()" class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1.5 rounded-full border border-indigo-100 hover:bg-indigo-100 hover:scale-105 transition-all cursor-pointer shadow-sm">
                                    <i class="fas fa-handshake text-[10px]"></i>
                                    @Model.MutualFriendsCount en común
                                </button>
                            }
                            <span class="inline-flex items-center gap-1.5 bg-purple-50 text-purple-700 text-xs font-bold px-3 py-1.5 rounded-full border border-purple-100">
                                <i class="fas fa-newspaper text-[10px]"></i>
                                @posts.Count publicación@(posts.Count != 1 ? "es" : "")
                            </span>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <form asp-controller="Friendship" asp-action="Delete" method="post"
                              onsubmit="return confirm('¿Está seguro que desea eliminar de sus amigos al usuario @Model.UserName?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="friendshipId" value="@ViewBag.FriendshipId" />
                            <button type="submit"
                                    class="inline-flex items-center gap-2 bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 px-4 py-2 rounded-xl text-sm font-bold transition-all shadow-sm">
                                <i class="fas fa-user-minus text-xs"></i> Eliminar Amigo
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Contact details strip -->
            <div class="flex flex-wrap gap-4 mt-5 pt-4 border-t border-gray-100 text-xs text-gray-500">
                <span class="inline-flex items-center gap-1.5">
                    <i class="fas fa-envelope text-gray-400"></i>
                    @Model.Email
                </span>
                <span class="inline-flex items-center gap-1.5">
                    <i class="fas fa-phone text-gray-400"></i>
                    @Model.Phone
                </span>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- POSTS FEED                                        -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="mt-6 space-y-5">
        <div class="flex items-center gap-3">
            <h2 class="text-lg font-black text-gray-900 flex items-center gap-2">
                <i class="fas fa-layer-group text-brand-blue"></i>
                Publicaciones de @Model.FullName
            </h2>
            <span class="text-xs font-bold bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full">@posts.Count</span>
        </div>

        @if (!posts.Any())
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="far fa-file-alt text-2xl text-gray-300"></i>
                </div>
                <p class="font-semibold text-gray-600">@Model.FullName no tiene publicaciones visibles aún.</p>
                <p class="text-xs text-gray-400 mt-1">Las publicaciones privadas no se muestran aquí.</p>
            </div>
        }
        else
        {
            foreach (var post in posts)
            {
                <article id="post-@post.Id" class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all border border-gray-200 p-5 space-y-4 post-anchor-target">

                    <!-- Post Header -->
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrEmpty(post.AuthorPhotoUrl))
                        {
                            <img src="@post.AuthorPhotoUrl" alt="" class="w-10 h-10 rounded-full object-cover border-2 border-brand-blue/20 shadow-sm" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">
                                @(post.AuthorName.Length > 0 ? post.AuthorName[0].ToString().ToUpper() : "?")
                            </div>
                        }
                        <div class="flex-grow">
                            <h4 class="font-bold text-gray-900 text-sm">@post.AuthorName</h4>
                            <div class="flex items-center gap-2 text-[11px] text-gray-400 mt-0.5">
                                <span>@post.Created.ToLocalTime().ToString("g")</span>
                                @if (post.EditionStatus == EditionStatus.Edited)
                                {
                                    <span>•</span>
                                    <span class="bg-blue-50 text-brand-blue px-1.5 py-0.5 rounded text-[10px] font-bold">Editada</span>
                                }
                                <span>•</span>
                                @if (post.PrivacyMode == PrivacyMode.FriendsOnly)
                                {
                                    <span class="flex items-center gap-0.5"><i class="fas fa-user-group text-brand-blue text-[10px]"></i> Amigos</span>
                                }
                                else
                                {
                                    <span class="flex items-center gap-0.5"><i class="fas fa-lock text-amber-500 text-[10px]"></i> Privado</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Text -->
                    <p class="text-gray-800 text-sm leading-relaxed whitespace-pre-line">@post.TextContent</p>

                    <!-- Media -->
                    @if (post.ContentType == ContentType.Image && !string.IsNullOrEmpty(post.MediaUrl))
                    {
                        <div class="rounded-xl overflow-hidden border border-gray-100">
                            <img src="@post.MediaUrl" alt="" class="w-full object-cover max-h-[400px]" />
                        </div>
                    }
                    else if (post.ContentType == ContentType.YouTubeVideo && !string.IsNullOrEmpty(post.MediaUrl))
                    {
                        <div class="aspect-video rounded-xl overflow-hidden border border-gray-100 bg-black">
                            <iframe src="@post.MediaUrl" class="w-full h-full" frameborder="0" allowfullscreen
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                        </div>
                    }

                    <hr class="border-gray-100" />

                    <!-- Reactions Bar -->
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-2">
                            @{
                                var userReaction = post.Reactions?.FirstOrDefault(r => r.UserId == userId);
                                var hasLike = userReaction != null && userReaction.ReactionType == ReactionType.Like;
                                var hasDislike = userReaction != null && userReaction.ReactionType == ReactionType.Dislike;
                            }
                            <!-- Like -->
                            <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="isLike" value="true" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Friendship", new { id = Model.UserId })" />
                                <button type="submit"
                                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full transition-all text-xs font-bold @(hasLike ? "bg-brand-blue/10 text-brand-blue" : "bg-gray-100 text-gray-500 hover:bg-blue-50 hover:text-brand-blue")"
                                        title="Me gusta">
                                    <i class="@(hasLike ? "fas" : "far") fa-thumbs-up"></i>
                                    <span>@post.LikesCount</span>
                                </button>
                            </form>

                            <!-- Dislike -->
                            <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="isLike" value="false" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Friendship", new { id = Model.UserId })" />
                                <button type="submit"
                                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full transition-all text-xs font-bold @(hasDislike ? "bg-red-100 text-red-500" : "bg-gray-100 text-gray-500 hover:bg-red-50 hover:text-red-500")"
                                        title="No me gusta">
                                    <i class="@(hasDislike ? "fas" : "far") fa-thumbs-down"></i>
                                    @if (post.DislikesCount > 0)
                                    {
                                        <span>@post.DislikesCount</span>
                                    }
                                </button>
                            </form>
                        </div>

                        <button type="button" onclick="document.getElementById('commentsSection-@post.Id').classList.toggle('hidden')"
                                class="flex items-center gap-1.5 text-xs font-bold text-gray-500 hover:text-emerald-600 bg-gray-100 hover:bg-emerald-50 px-3 py-1.5 rounded-full transition-all">
                            <i class="far fa-comment-dots"></i>
                            <span>@post.CommentsCount comentario@(post.CommentsCount != 1 ? "s" : "")</span>
                        </button>
                    </div>

                    <!-- Comments Section -->
                    <div id="commentsSection-@post.Id" class="pt-3 border-t border-gray-100 space-y-3">
                        @if (post.Comments != null && post.Comments.Any())
                        {
                            <div class="space-y-3 max-h-[280px] overflow-y-auto pr-1">
                                @{
                                    async Task RenderProfilePostCommentsAsync(IEnumerable<LinkUpPro.Core.Application.DTOs.CommentDTO.CommentDTO> comments, int depth = 0)
                                    {
                                        var commentsToRender = depth == 0 ? comments.Where(c => c.ParentCommentId == null || c.ParentCommentId == 0) : comments;
                                        foreach (var comment in commentsToRender)
                                        {
                                            var isMyComment = comment.AuthorId == userId;
                                            var isDeletedPlaceholder = comment.Content == "Este comentario fue eliminado." || comment.Content == "comentario eliminado" || comment.Content == "Comentario eliminado";

                                            <div class="bg-gray-50 hover:bg-gray-100/70 p-3 rounded-xl border border-gray-100 transition-all @(depth > 0 ? "ml-7 border-l-2 border-brand-blue/30" : "")">
                                                <div class="flex justify-between items-start gap-2">
                                                    <div class="flex items-center gap-2">
                                                        @if (!isDeletedPlaceholder && !string.IsNullOrEmpty(comment.AuthorPhotoUrl))
                                                        {
                                                            <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@comment.AuthorId" class="flex-shrink-0">
                                                                <img src="@comment.AuthorPhotoUrl" alt="" class="w-7 h-7 rounded-full object-cover hover:ring-2 hover:ring-brand-blue transition-all" />
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 flex-shrink-0">
                                                                <i class="fas fa-user text-xs"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            @if (!isDeletedPlaceholder)
                                                            {
                                                                <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@comment.AuthorId"
                                                                   class="font-bold text-xs text-gray-900 hover:text-brand-blue transition-colors">
                                                                    @comment.AuthorName
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span class="font-bold text-xs text-gray-500">[Eliminado]</span>
                                                            }
                                                            <span class="text-[10px] text-gray-400 ml-1.5">
                                                                @comment.Created.ToLocalTime().ToString("g")
                                                                @if (comment.IsEdited && !isDeletedPlaceholder)
                                                                {
                                                                    <span class="bg-blue-50 text-brand-blue px-1.5 py-0.5 rounded text-[9px] font-extrabold border border-blue-100 ml-1">Editado</span>
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>

                                                    @if (isMyComment && !isDeletedPlaceholder)
                                                    {
                                                        <div class="flex items-center gap-1">
                                                            <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="text-gray-400 hover:text-brand-blue text-xs p-1 rounded hover:bg-white transition-colors" title="Editar">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" onsubmit="return confirm('¿Está seguro que desea eliminar este comentario?');" class="inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="text-gray-400 hover:text-red-500 text-xs p-1 rounded hover:bg-white transition-colors" title="Eliminar">
                                                                    <i class="fas fa-trash-alt"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="mt-2 text-xs text-gray-700 pl-9">
                                                    <p id="commentContent-@comment.Id" class="leading-relaxed">
                                                        @comment.Content
                                                        @if (comment.IsEdited)
                                                        {
                                                            <span class="text-[11px] text-gray-400 font-normal italic ml-1">(editado)</span>
                                                        }
                                                    </p>
                                                    <form id="commentEditForm-@comment.Id" asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id" method="post" class="hidden mt-2 space-y-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="text" name="content" value="@comment.Content" required class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-lg focus:ring-1 focus:ring-brand-blue outline-none" />
                                                        <div class="flex justify-end gap-1.5">
                                                            <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="px-2.5 py-1 text-[10px] font-bold bg-gray-200 text-gray-600 rounded">Cancelar</button>
                                                            <button type="submit" class="px-2.5 py-1 text-[10px] font-bold bg-brand-blue text-white rounded hover:bg-blue-800">Guardar</button>
                                                        </div>
                                                    </form>
                                                </div>

                                                @if (post.CommentStatus == CommentStatus.Allowed && !isDeletedPlaceholder)
                                                {
                                                    <div class="mt-2 pl-9">
                                                        <button type="button" onclick="toggleReplyForm(@comment.Id)" class="text-xs text-brand-blue hover:underline font-semibold flex items-center gap-1">
                                                            <i class="fas fa-reply text-[10px]"></i> Responder
                                                        </button>
                                                        <form id="replyForm-@comment.Id" asp-controller="Comment" asp-action="Create" method="post" class="hidden mt-2 space-y-2">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="PostId" value="@post.Id" />
                                                            <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                                            <input type="text" name="Content" required maxlength="500" placeholder="Responder a @comment.AuthorName..."
                                                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-brand-blue outline-none" />
                                                            <div class="flex justify-end gap-1.5">
                                                                <button type="button" onclick="toggleReplyForm(@comment.Id)" class="px-3 py-1 bg-gray-200 text-gray-600 rounded text-xs font-bold">Cancelar</button>
                                                                <button type="submit" class="bg-brand-blue text-white px-3 py-1 rounded text-xs font-bold hover:bg-blue-800">Enviar</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                }
                                            </div>

                                            if (comment.Replies != null && comment.Replies.Any())
                                            {
                                                await RenderProfilePostCommentsAsync(comment.Replies, depth + 1);
                                            }
                                        }
                                    }

                                    await RenderProfilePostCommentsAsync(post.Comments);
                                }
                            </div>
                        }

                        <!-- Add comment -->
                        @if (post.CommentStatus == CommentStatus.Allowed)
                        {
                            <form asp-controller="Comment" asp-action="Create" method="post" class="flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PostId" value="@post.Id" />
                                <input type="text" name="Content" required maxlength="500" placeholder="Escribe un comentario..."
                                    class="flex-grow px-4 py-2 border border-gray-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-blue outline-none" />
                                <button type="submit" class="bg-brand-blue text-white px-4 py-2 rounded-xl text-xs font-bold hover:bg-blue-800 transition-colors shadow-sm">
                                    Comentar
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

<!-- ══════════════════════════════════════════════════ -->
<!-- MODAL: Mutual Friends List                         -->
<!-- ══════════════════════════════════════════════════ -->
<div id="mutualFriendsModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-200 max-w-md w-full mx-4 overflow-hidden transform transition-all">
        <div class="bg-gradient-to-r from-brand-blue to-indigo-600 px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-white text-sm">
                    <i class="fas fa-handshake"></i>
                </div>
                <div>
                    <h3 class="text-white font-black text-base">Amigos en Común</h3>
                    <p class="text-blue-100 text-xs">Con @Model.FullName</p>
                </div>
            </div>
            <button type="button" onclick="closeMutualFriendsModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <div class="p-4 max-h-96 overflow-y-auto divide-y divide-gray-100">
            @if (!Model.MutualFriends.Any())
            {
                <div class="py-8 text-center text-gray-400">
                    <i class="fas fa-user-friends text-3xl mb-2 text-gray-300"></i>
                    <p class="text-sm font-semibold text-gray-600">No tienen amigos en común.</p>
                </div>
            }
            else
            {
                @foreach (var mFriend in Model.MutualFriends)
                {
                    <a asp-controller="Friendship" asp-action="Profile" asp-route-id="@mFriend.UserId"
                       class="flex items-center justify-between p-3.5 hover:bg-indigo-50/50 rounded-2xl transition-all group">
                        <div class="flex items-center gap-3 min-w-0">
                            @if (!string.IsNullOrEmpty(mFriend.ProfilePhoto))
                            {
                                <img src="@mFriend.ProfilePhoto" alt="@mFriend.FullName" class="w-11 h-11 rounded-full object-cover border-2 border-white shadow-sm flex-shrink-0" />
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-full bg-gradient-to-br from-indigo-500 to-brand-blue flex items-center justify-center text-white font-bold text-sm shadow-sm flex-shrink-0">
                                    @(mFriend.FullName.Length > 0 ? mFriend.FullName[0].ToString().ToUpper() : "?")
                                </div>
                            }
                            <div class="min-w-0">
                                <h4 class="font-bold text-gray-900 text-sm truncate group-hover:text-brand-blue transition-colors">@mFriend.FullName</h4>
                                <p class="text-xs text-gray-400 truncate">&#64;@mFriend.UserName</p>
                            </div>
                        </div>
                        <span class="bg-indigo-50 text-indigo-700 group-hover:bg-indigo-100 px-3 py-1.5 rounded-xl text-xs font-bold transition-colors flex items-center gap-1.5 flex-shrink-0">
                            <i class="fas fa-eye text-[10px]"></i> Ver perfil
                        </span>
                    </a>
                }
            }
        </div>

        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100 flex justify-end">
            <button type="button" onclick="closeMutualFriendsModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-5 py-2 rounded-xl text-sm font-bold transition-colors">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openMutualFriendsModal() {
            document.getElementById('mutualFriendsModal').classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
        function closeMutualFriendsModal() {
            document.getElementById('mutualFriendsModal').classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        function toggleReplyForm(commentId) {
            const form = document.getElementById('replyForm-' + commentId);
            if (form) form.classList.toggle('hidden');
        }

        function toggleCommentEditForm(commentId) {
            const text = document.getElementById('commentContent-' + commentId);
            const form = document.getElementById('commentEditForm-' + commentId);
            if (text) text.classList.toggle('hidden');
            if (form) form.classList.toggle('hidden');
        }
    </script>
}
