@using LinkUpPro.Core.Domain.Common.Enums
@using System.Security.Claims
@model List<LinkUpPro.Core.Application.DTOs.PostDTO.PostDTO>
@{
    ViewData["Title"] = "Inicio";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm flex items-center gap-2">
            <i class="fas fa-check-circle text-green-500"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    
    @if (TempData["CreatePostError"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm">
            <i class="fas fa-exclamation-circle mr-1"></i> @Html.Raw(TempData["CreatePostError"])
        </div>
    }

    @if (TempData["CommentError"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-4">
            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["CommentError"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-pen text-brand-blue"></i> Crear Publicación
        </h2>
        <form asp-controller="Post" asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <!-- Text Content -->
            <div>
                <textarea name="TextContent" rows="3" maxlength="1000" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all resize-none placeholder-gray-400"
                    placeholder="¿Qué estás pensando hoy?"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Content Type -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Tipo de Multimedia</label>
                    <select name="ContentType" id="createContentType" onchange="toggleMediaFields()"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)ContentType.Image)">Imagen</option>
                        <option value="@((int)ContentType.YouTubeVideo)">Video de YouTube</option>
                    </select>
                </div>

                <!-- Privacy Mode -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Privacidad</label>
                    <select name="PrivacyMode"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)PrivacyMode.FriendsOnly)">Solo Amigos</option>
                        <option value="@((int)PrivacyMode.OnlyMe)">Solo Yo</option>
                    </select>
                </div>

                <!-- Comment Status -->
                <div class="flex items-center h-full pt-4 md:pt-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="CommentStatus" value="@((int)CommentStatus.Allowed)" checked
                            class="w-4 h-4 text-brand-blue border-gray-300 rounded focus:ring-brand-blue" />
                        <span class="text-sm font-medium text-gray-700">Permitir comentarios</span>
                    </label>
                </div>
            </div>

            <!-- Conditional Upload Fields -->
            <div id="imageFieldGroup" class="bg-gray-50 p-4 rounded-xl border border-dashed border-gray-300">
                <label class="block text-sm font-medium text-gray-700 mb-1">Seleccionar Imagen</label>
                <input type="file" name="ImageFile" accept=".jpg,.jpeg,.png,.webp" id="imageInput"
                    class="w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-blue file:text-white hover:file:bg-blue-800 file:cursor-pointer" />
                <p class="text-xs text-gray-400 mt-1">Formatos permitidos: .jpg, .jpeg, .png, .webp. Máximo 5 MB.</p>
            </div>

            <div id="videoFieldGroup" class="bg-gray-50 p-4 rounded-xl border border-gray-300 hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1">Enlace de YouTube</label>
                <input type="url" name="MediaUrl" id="videoUrlInput"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all"
                    placeholder="https://www.youtube.com/watch?v=..." />
                <p class="text-xs text-gray-400 mt-1">Ingrese la dirección del video completo de YouTube.</p>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end pt-2">
                <button type="submit" class="bg-brand-blue text-white px-6 py-2 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-sm flex items-center gap-2">
                    <i class="fas fa-paper-plane"></i> Publicar
                </button>
            </div>
        </form>
    </div>

    <!-- 2. Buscador y Filtros -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-filter text-brand-blue"></i> Buscar y Filtrar
        </h2>
        <form asp-controller="Home" asp-action="Index" method="get" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Text Filter -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Buscar por texto</label>
                    <input type="text" name="textFilter" value="@ViewBag.TextFilter"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all"
                        placeholder="Contenido..." />
                </div>

                <!-- Content Type Filter -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Tipo de Contenido</label>
                    <select name="contentType"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)ContentType.All)" selected="@(ViewBag.ContentType == ContentType.All)">Todos</option>
                        <option value="@((int)ContentType.Image)" selected="@(ViewBag.ContentType == ContentType.Image)">Imagen</option>
                        <option value="@((int)ContentType.YouTubeVideo)" selected="@(ViewBag.ContentType == ContentType.YouTubeVideo)">Video de YouTube</option>
                    </select>
                </div>

                <!-- Edition Status Filter -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Estado de Edición</label>
                    <select name="editionStatus"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)EditionStatus.All)" selected="@(ViewBag.EditionStatus == EditionStatus.All)">Todas</option>
                        <option value="@((int)EditionStatus.Edited)" selected="@(ViewBag.EditionStatus == EditionStatus.Edited)">Editadas</option>
                        <option value="@((int)EditionStatus.NotEdited)" selected="@(ViewBag.EditionStatus == EditionStatus.NotEdited)">No editadas</option>
                    </select>
                </div>

                <!-- Date From -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Fecha Desde</label>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all" />
                </div>

                <!-- Date To -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Fecha Hasta</label>
                    <input type="date" name="dateTo" value="@ViewBag.DateTo"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all" />
                </div>

                <!-- Action Buttons -->
                <div class="flex items-end gap-2 pt-4 md:pt-0">
                    <button type="submit" class="flex-1 bg-brand-blue text-white py-2 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-sm">
                        <i class="fas fa-search mr-1"></i> Buscar
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="flex-1 text-center bg-gray-200 text-gray-700 py-2 rounded-lg font-bold hover:bg-gray-300 transition-colors">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- 3. Listado de Publicaciones -->
    <div class="space-y-6">
        @if (Model == null || !Model.Any())
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center">
                <i class="far fa-folder-open text-gray-400 text-4xl mb-3"></i>
                <p class="text-gray-500 font-medium">
                    @(string.IsNullOrEmpty(ViewBag.TextFilter) && ViewBag.DateFrom == null && ViewBag.DateTo == null ? "Todavía no ha realizado ninguna publicación." : "No se encontraron publicaciones que coincidan con los criterios seleccionados.")
                </p>
            </div>
        }
        else
        {
            foreach (var post in Model)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-4">
                    <!-- Post Header -->
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(post.AuthorPhotoUrl))
                            {
                                <img src="@post.AuthorPhotoUrl" alt="Foto" class="w-10 h-10 rounded-full object-cover border border-gray-200" />
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 border border-gray-200">
                                    <i class="fas fa-user text-lg"></i>
                                </div>
                            }
                            <div>
                                <h4 class="font-bold text-gray-900 leading-tight">@post.AuthorName</h4>
                                <div class="flex items-center gap-2 text-xs text-gray-400 mt-0.5">
                                    <span>@post.Created.ToLocalTime().ToString("g")</span>
                                    <span>•</span>
                                    <span>
                                        @if (post.PrivacyMode == PrivacyMode.FriendsOnly)
                                        {
                                            <i class="fas fa-user-group" title="Solo amigos"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-lock" title="Solo yo"></i>
                                        }
                                    </span>
                                    @if (post.EditionStatus == EditionStatus.Edited)
                                    {
                                        <span class="bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded text-[10px] font-bold">Editada</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Edit/Delete Options -->
                        <div class="flex items-center gap-1.5">
                            <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="text-gray-400 hover:text-brand-blue p-1.5 rounded-lg hover:bg-gray-50 transition-colors">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" class="text-gray-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-gray-50 transition-colors">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Post Body (Text) -->
                    <p class="text-gray-800 leading-relaxed whitespace-pre-line">@post.TextContent</p>

                    <!-- Post Body (Media) -->
                    @if (post.ContentType == ContentType.Image && !string.IsNullOrEmpty(post.MediaUrl))
                    {
                        <div class="rounded-xl overflow-hidden border border-gray-100 max-h-[450px]">
                            <img src="@post.MediaUrl" alt="Media" class="w-full h-full object-cover" />
                        </div>
                    }
                    else if (post.ContentType == ContentType.YouTubeVideo && !string.IsNullOrEmpty(post.MediaUrl))
                    {
                        <div class="aspect-video rounded-xl overflow-hidden border border-gray-100 bg-black">
                            <iframe src="@post.MediaUrl" class="w-full h-full" frameborder="0" allowfullscreen
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                        </div>
                    }

                    <hr class="border-gray-100" />

                    <!-- Reactions and Comment Toggle Bar -->
                    <div class="flex items-center justify-between text-sm text-gray-500 font-medium">
                        <!-- Likes and Dislikes -->
                        <div class="flex items-center gap-4">
                            @{
                                var userReaction = post.Reactions?.FirstOrDefault(r => r.UserId == userId);
                                var hasLike = userReaction != null && userReaction.ReactionType == ReactionType.Like;
                                var hasDislike = userReaction != null && userReaction.ReactionType == ReactionType.Dislike;
                            }
                            <!-- Like button -->
                            <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="isLike" value="true" />
                                <input type="hidden" name="returnUrl" value="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString())" />
                                <button type="submit" class="flex items-center gap-1.5 hover:text-brand-blue transition-colors @(hasLike ? "text-brand-blue font-bold" : "")">
                                    <i class="@(hasLike ? "fas" : "far") fa-thumbs-up"></i>
                                    <span>@post.ReactionsCount</span>
                                </button>
                            </form>

                            <!-- Dislike button -->
                            <form asp-controller="Reaction" asp-action="Toggle" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="isLike" value="false" />
                                <input type="hidden" name="returnUrl" value="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString())" />
                                <button type="submit" class="flex items-center gap-1.5 hover:text-red-500 transition-colors @(hasDislike ? "text-red-500 font-bold" : "")">
                                    <i class="@(hasDislike ? "fas" : "far") fa-thumbs-down"></i>
                                </button>
                            </form>

                            @if (userReaction != null)
                            {
                                <span class="text-xs text-gray-400">
                                    Tu reacción: @(userReaction.ReactionType == ReactionType.Like ? "Me gusta" : "No me gusta")
                                </span>
                            }
                        </div>

                        <!-- Comment count icon -->
                        <div class="flex items-center gap-1.5">
                            <i class="far fa-message"></i>
                            <span>@post.CommentsCount comentarios</span>
                        </div>
                    </div>

                    <!-- 4. Comentarios Section -->
                    <div class="pt-4 border-t border-gray-100 space-y-4">
                        @if (post.Comments != null && post.Comments.Any())
                        {
                            <div class="space-y-4 max-h-[300px] overflow-y-auto pr-2">
                                @{
                                    async Task RenderCommentsAsync(IEnumerable<LinkUpPro.Core.Application.DTOs.CommentDTO.CommentDTO> comments, int depth = 0)
                                    {
                                        foreach (var comment in comments)
                                        {
                                            var isMyComment = comment.AuthorId == userId;
                                            var isDeletedPlaceholder = comment.Content == "Este comentario fue eliminado.";
                                            
                                            <div class="bg-gray-50/70 p-3 rounded-xl border border-gray-100 relative @(depth > 0 ? "ml-8 border-l-2 border-brand-blue/20" : "")">
                                                <div class="flex justify-between items-start">
                                                    <div class="flex items-center gap-2">
                                                        @if (!isDeletedPlaceholder && !string.IsNullOrEmpty(comment.AuthorPhotoUrl))
                                                        {
                                                            <img src="@comment.AuthorPhotoUrl" alt="" class="w-6 h-6 rounded-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-gray-400">
                                                                <i class="fas fa-user text-xs"></i>
                                                            </div>
                                                        }
                                                        <span class="font-bold text-xs text-gray-800">
                                                            @(isDeletedPlaceholder ? "[Eliminado]" : comment.AuthorName)
                                                        </span>
                                                        <span class="text-[10px] text-gray-400">@comment.Created.ToLocalTime().ToString("g")</span>
                                                    </div>

                                                    @if (isMyComment && !isDeletedPlaceholder)
                                                    {
                                                        <div class="flex items-center gap-1">
                                                            <!-- Edit comment button (show inline form) -->
                                                            <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="text-gray-400 hover:text-brand-blue text-xs p-1">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <!-- Delete comment form -->
                                                            <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" onsubmit="return confirm('¿Está seguro de eliminar este comentario?');" class="inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="text-gray-400 hover:text-red-500 text-xs p-1">
                                                                    <i class="fas fa-trash-alt"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Comment Content -->
                                                <div class="mt-2 text-sm text-gray-700">
                                                    <p id="commentContent-@comment.Id">@comment.Content</p>
                                                    
                                                    <!-- Comment Edit Form -->
                                                    <form id="commentEditForm-@comment.Id" asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id" method="post" class="hidden mt-2 space-y-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="text" name="content" value="@comment.Content" required class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-md focus:ring-1 focus:ring-brand-blue outline-none" />
                                                        <div class="flex justify-end gap-1.5">
                                                            <button type="button" onclick="toggleCommentEditForm(@comment.Id)" class="px-2.5 py-1 text-[10px] font-bold bg-gray-200 text-gray-600 rounded">Cancelar</button>
                                                            <button type="submit" class="px-2.5 py-1 text-[10px] font-bold bg-brand-blue text-white rounded hover:bg-blue-800">Guardar</button>
                                                        </div>
                                                    </form>
                                                </div>

                                                <!-- Reply Button and Nested Form -->
                                                @if (post.CommentStatus == CommentStatus.Allowed && !isDeletedPlaceholder)
                                                {
                                                    <div class="mt-2 flex justify-start">
                                                        <button type="button" onclick="toggleReplyForm(@comment.Id)" class="text-xs text-brand-blue hover:underline font-semibold flex items-center gap-1">
                                                            <i class="fas fa-reply"></i> Responder
                                                        </button>
                                                    </div>

                                                    <!-- Reply Input Form -->
                                                    <form id="replyForm-@comment.Id" asp-controller="Comment" asp-action="Create" method="post" class="hidden mt-2 space-y-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="PostId" value="@post.Id" />
                                                        <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                                        <input type="text" name="Content" required maxlength="500" placeholder="Escribe una respuesta..."
                                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-brand-blue outline-none" />
                                                        <div class="flex justify-end gap-1.5">
                                                            <button type="button" onclick="toggleReplyForm(@comment.Id)" class="px-3 py-1 bg-gray-200 text-gray-600 rounded-md text-xs font-bold">Cancelar</button>
                                                            <button type="submit" class="bg-brand-blue text-white px-3 py-1 rounded-md text-xs font-bold hover:bg-blue-800">Enviar</button>
                                                        </div>
                                                    </form>
                                                }
                                            </div>

                                            if (comment.Replies != null && comment.Replies.Any())
                                            {
                                                await RenderCommentsAsync(comment.Replies, depth + 1);
                                            }
                                        }
                                    }

                                    await RenderCommentsAsync(post.Comments);
                                }
                            </div>
                        }

                        <!-- Add Comment form -->
                        @if (post.CommentStatus == CommentStatus.Allowed)
                        {
                            <form asp-controller="Comment" asp-action="Create" method="post" class="flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PostId" value="@post.Id" />
                                <input type="text" name="Content" required maxlength="500" placeholder="Escribe un comentario..."
                                    class="flex-grow px-4 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all" />
                                <button type="submit" class="bg-brand-blue text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-blue-800 transition-colors shadow-sm flex items-center gap-1">
                                    <i class="fas fa-comment"></i> Comentar
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="bg-gray-50 border border-gray-200 text-gray-500 rounded-xl p-3 text-center text-xs font-medium">
                                <i class="fas fa-comment-slash mr-1"></i> Los comentarios están desactivados para esta publicación.
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleMediaFields() {
            const type = document.getElementById('createContentType').value;
            const imageGroup = document.getElementById('imageFieldGroup');
            const videoGroup = document.getElementById('videoFieldGroup');
            const imageInput = document.getElementById('imageInput');
            const videoInput = document.getElementById('videoUrlInput');

            if (type == '@((int)ContentType.Image)') {
                imageGroup.classList.remove('hidden');
                videoGroup.classList.add('hidden');
                videoInput.value = ''; // Clean previous link
            } else {
                imageGroup.classList.add('hidden');
                videoGroup.classList.remove('hidden');
                imageInput.value = ''; // Clean previous file
            }
        }

        function toggleReplyForm(commentId) {
            const form = document.getElementById('replyForm-' + commentId);
            form.classList.toggle('hidden');
        }

        function toggleCommentEditForm(commentId) {
            const text = document.getElementById('commentContent-' + commentId);
            const form = document.getElementById('commentEditForm-' + commentId);
            text.classList.toggle('hidden');
            form.classList.toggle('hidden');
        }

        // Run on load to set fields
        document.addEventListener('DOMContentLoaded', toggleMediaFields);
    </script>
}
