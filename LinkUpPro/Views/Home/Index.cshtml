@model LinkUpPro.Core.Application.ViewModels.User.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    ViewData["HideNav"] = true; 
}

<style>
    /* Ajustes específicos para el fondo del login para dar ese efecto "grisáceo azul transparente" */
    body {
        background-color: #e8edf3; /* Gris azulado base */
        background-image: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.8) 0%, rgba(232,237,243,1) 80%);
        overflow-x: hidden;
    }

    .dots-pattern {
        background-image: radial-gradient(#cbd5e1 2px, transparent 2px);
        background-size: 20px 20px;
    }
</style>

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -left-32 top-20 w-[500px] h-[500px] border-[60px] border-white/40 rounded-full"></div>
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-48 h-32 dots-pattern opacity-40"></div>
    <i class="fas fa-plus absolute top-32 right-32 text-gray-400/50 text-3xl rotate-45"></i>
    <i class="fas fa-plus absolute bottom-40 right-20 text-gray-400/50 text-2xl"></i>
    <i class="fas fa-plus absolute bottom-32 left-1/4 text-gray-400/50 text-xl rotate-12"></i>
    <i class="fas fa-ship absolute top-10 right-40 text-gray-300/40 text-6xl"></i>
    <i class="fas fa-ship absolute top-40 right-10 text-gray-300/30 text-4xl"></i>
</div>

<div class="min-h-screen flex items-center justify-center w-full">
    <div class="max-w-[1400px] w-full mx-auto p-4 flex flex-col lg:flex-row items-center justify-between gap-12 z-10">

        <div class="w-full lg:w-[55%] flex flex-col items-center">

            <div class="text-center mb-10">
                <div class="flex flex-col items-center justify-center gap-1 mb-2">
                    <i class="fas fa-infinity text-brand-blue text-[5rem] drop-shadow-sm"></i>
                    <h1 class="text-5xl font-bold text-gray-800 tracking-tight mt-2">
                        LinkUp <span class="text-brand-blue">Pro</span>
                    </h1>
                </div>
                <p class="text-xl text-gray-500 font-medium">Conecta. Comparte. Compite.</p>
            </div>

            <div class="flex justify-center gap-10 text-center w-full max-w-lg mb-10">
                <div class="flex-1">
                    <i class="fas fa-user-friends text-brand-blue text-3xl mb-3"></i>
                    <h3 class="font-bold text-gray-800 mb-1">Conecta</h3>
                    <p class="text-xs text-gray-500 leading-tight">Haz nuevos amigos<br>y amplía tu red.</p>
                </div>
                <div class="flex-1">
                    <i class="far fa-comment-dots text-brand-blue text-3xl mb-3"></i>
                    <h3 class="font-bold text-gray-800 mb-1">Comparte</h3>
                    <p class="text-xs text-gray-500 leading-tight">Publica, comenta y<br>comparte momentos.</p>
                </div>
                <div class="flex-1">
                    <i class="fas fa-bullseye text-brand-blue text-3xl mb-3"></i>
                    <h3 class="font-bold text-gray-800 mb-1">Compite</h3>
                    <p class="text-xs text-gray-500 leading-tight">Desafía a tus amigos<br>en Battleship.</p>
                </div>
            </div>

            <div class="relative w-full h-[350px] flex justify-center items-center mt-2">
                <div class="absolute left-[5%] lg:left-[12%] top-10 w-[200px] h-[280px] bg-white rounded-[1.5rem] shadow-xl border border-gray-100 -rotate-[6deg] z-10 flex flex-col">
                    <div class="p-3 border-b border-gray-100 flex justify-between items-center"><span class="font-bold text-xs text-gray-700">Amigos</span></div>
                    <div class="p-3 flex-1 bg-gray-50 space-y-4">
                        <div class="h-6 bg-gray-200 rounded-full w-full"></div>
                        <div class="flex gap-2 items-center"><div class="w-8 h-8 bg-gray-300 rounded-full"></div><div class="w-20 h-2 bg-gray-400 rounded"></div></div>
                        <div class="flex gap-2 items-center"><div class="w-8 h-8 bg-gray-300 rounded-full"></div><div class="w-16 h-2 bg-gray-400 rounded"></div></div>
                    </div>
                </div>

                <div class="absolute left-1/2 -translate-x-1/2 -top-4 w-[260px] h-[340px] bg-white rounded-[1.5rem] shadow-2xl border border-gray-100 z-30 flex flex-col">
                    <div class="p-3 border-b border-gray-100 text-center"><span class="font-bold text-sm text-gray-800">Battleship</span></div>
                    <div class="flex-1 p-2 bg-gray-50 flex justify-center items-center">
                        <div class="w-full h-full border border-gray-200 bg-white relative">
                            <div class="absolute inset-0" style="background-image: linear-gradient(#e5e7eb 1px, transparent 1px), linear-gradient(90deg, #e5e7eb 1px, transparent 1px); background-size: 20px 20px;"></div>
                            <div class="absolute top-[40px] left-[40px] w-[80px] h-[15px] bg-[#334155] rounded-full"></div>
                            <div class="absolute top-[100px] left-[140px] w-[15px] h-[100px] bg-[#334155] rounded-full"></div>
                            <i class="far fa-circle text-brand-blue text-[10px] absolute top-[85px] left-[25px]"></i>
                            <i class="fas fa-times text-red-500 text-[10px] absolute bottom-[45px] left-[85px]"></i>
                        </div>
                    </div>
                    <div class="p-3 bg-white border-t flex justify-between items-center text-xs">
                        <span class="font-bold text-brand-blue">Turno: Tú</span><span class="text-gray-500">Restantes: 17</span>
                    </div>
                </div>

                <div class="absolute right-[5%] lg:right-[12%] top-6 w-[210px] h-[290px] bg-white rounded-[1.5rem] shadow-xl border border-gray-100 rotate-[8deg] z-20 flex flex-col">
                    <div class="p-3 border-b border-gray-100"><span class="font-bold text-xs text-gray-700">Publicaciones</span></div>
                    <div class="flex-1 p-3 bg-gray-50">
                        <div class="bg-white p-2 rounded border border-gray-100 mb-3"><div class="h-2 w-20 bg-gray-300 rounded mb-2"></div><div class="h-20 w-full bg-gradient-to-tr from-pink-400 to-orange-400 rounded"></div></div>
                    </div>
                </div>
            </div>

            <div class="mt-10 bg-white px-6 py-2.5 rounded-full shadow-md flex items-center gap-3 border border-gray-100">
                <i class="fas fa-users text-brand-blue"></i>
                <span class="font-bold text-gray-700 text-sm">12,842 <span class="font-normal text-gray-500">usuarios activos ahora</span></span>
                <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
            </div>
        </div>

        <div class="w-full lg:w-[45%] flex justify-center lg:justify-end mt-12 lg:mt-0">

            <div class="bg-white w-full max-w-[480px] rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.08)] p-10 sm:p-12 border border-gray-100">
                <h2 class="text-3xl font-bold text-gray-900 mb-2">¡Bienvenido de vuelta!</h2>
                <p class="text-gray-500 text-base mb-8">Inicia sesión para continuar</p>

                <!-- Status messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-sm">
                        <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm">
                        <i class="fas fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <!-- Validation errors -->
                <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <form asp-controller="User" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-5">
                        <label asp-for="UserName" class="block text-sm font-bold text-gray-700 mb-2"></label>
                        <div class="relative flex items-center">
                            <i class="far fa-user absolute left-4 text-gray-400 text-lg"></i>
                            <input asp-for="UserName" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-base rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue block pl-12 p-4 transition-all outline-none" placeholder="Ingresa tu nombre de usuario" required>
                        </div>
                        <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Password" class="block text-sm font-bold text-gray-700 mb-2"></label>
                        <div class="relative flex items-center">
                            <i class="fas fa-lock absolute left-4 text-gray-400 text-lg"></i>
                            <input asp-for="Password" id="passwordField" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-base rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue block pl-12 pr-12 p-4 transition-all outline-none" placeholder="Ingresa tu contraseña" required>
                            <button type="button" onclick="togglePassword('passwordField', 'toggleIcon')" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600">
                                <i id="toggleIcon" class="far fa-eye text-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="flex items-center mb-8">
                        <div class="flex items-center h-5">
                            <input asp-for="RememberMe" type="checkbox" class="w-5 h-5 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-brand-blue text-brand-blue cursor-pointer">
                        </div>
                        <label asp-for="RememberMe" class="ml-3 text-sm font-medium text-gray-600 cursor-pointer"></label>
                    </div>

                    <button type="submit" class="w-full text-white bg-brand-blue hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-bold rounded-xl text-lg px-5 py-4 text-center shadow-lg shadow-blue-500/30 transition-all">
                        Iniciar sesión
                    </button>
                </form>

                <div class="relative flex py-8 items-center">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-sm">o</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <a asp-controller="User" asp-action="GoogleLogin" class="w-full flex items-center justify-center gap-3 bg-white border border-gray-200 text-gray-700 font-bold rounded-xl text-base px-5 py-4 text-center hover:bg-gray-50 transition-all mb-8 shadow-sm cursor-pointer">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" class="w-6 h-6">
                    Iniciar sesión con Google
                </a>

                <div class="flex flex-col gap-2">
                    <a asp-controller="User" asp-action="Register" class="flex justify-between items-center py-3 text-gray-600 hover:text-brand-blue font-medium text-sm border-b border-gray-100 transition-colors">
                        <span><i class="fas fa-user-plus w-6 text-center mr-2 text-gray-400"></i> Crear una cuenta</span>
                        <i class="fas fa-chevron-right text-xs text-gray-300"></i>
                    </a>
                    <a asp-controller="User" asp-action="ForgotPassword" class="flex justify-between items-center py-3 text-gray-600 hover:text-brand-blue font-medium text-sm border-b border-gray-100 transition-colors">
                        <span><i class="fas fa-unlock-alt w-6 text-center mr-2 text-gray-400"></i> ¿Olvidaste tu contraseña?</span>
                        <i class="fas fa-chevron-right text-xs text-gray-300"></i>
                    </a>
                    <a asp-controller="User" asp-action="ResendActivation" class="flex justify-between items-center py-3 text-gray-600 hover:text-brand-blue font-medium text-sm transition-colors">
                        <span><i class="fas fa-envelope-open-text w-6 text-center mr-2 text-gray-400"></i> Reenviar activación</span>
                        <i class="fas fa-chevron-right text-xs text-gray-300"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}