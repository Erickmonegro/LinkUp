@model LinkUpPro.Core.Application.DTOs.PostDTO.PostDTO
@{
    ViewData["Title"] = "Eliminar Publicación";
}

<div class="max-w-md mx-auto">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center space-y-6">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto">
            <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
        </div>
        
        <div>
            <h1 class="text-xl font-bold text-gray-900">¿Está seguro que desea eliminar esta publicación?</h1>
            <p class="text-sm text-gray-500 mt-2">Esta acción no se puede deshacer de forma pública.</p>
        </div>

        <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 text-left text-sm text-gray-700">
            <p class="font-semibold text-gray-900 mb-1">Contenido de la publicación:</p>
            <p class="line-clamp-3 italic">"@Model.TextContent"</p>
        </div>

        <form asp-controller="Post" asp-action="Delete" method="post" class="flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            
            <a asp-controller="Home" asp-action="Index" class="flex-1 py-2.5 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="flex-1 bg-red-600 text-white py-2.5 rounded-lg font-bold hover:bg-red-700 transition-colors shadow-md">
                Aceptar
            </button>
        </form>
    </div>
</div>
