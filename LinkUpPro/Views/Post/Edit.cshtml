@model LinkUpPro.Core.Application.ViewModels.Post.SavePostViewModel
@using LinkUpPro.Core.Domain.Common.Enums
@{
    ViewData["Title"] = "Editar Publicación";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-2 mb-6">
            <a asp-controller="Home" asp-action="Index" class="text-gray-400 hover:text-brand-blue transition-colors text-lg">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Editar Publicación</h1>
        </div>

        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-4" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <form asp-controller="Post" asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AuthorId" />

            <!-- Text Content -->
            <div>
                <label asp-for="TextContent" class="block text-sm font-bold text-gray-700 mb-2"></label>
                <textarea asp-for="TextContent" rows="4" maxlength="1000" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all resize-none placeholder-gray-400"></textarea>
                <span asp-validation-for="TextContent" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Content Type -->
                <div>
                    <label asp-for="ContentType" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2"></label>
                    <select asp-for="ContentType" id="editContentType" onchange="toggleMediaFields()"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)ContentType.Image)" selected="@(Model.ContentType == ContentType.Image)">Imagen</option>
                        <option value="@((int)ContentType.YouTubeVideo)" selected="@(Model.ContentType == ContentType.YouTubeVideo)">Video de YouTube</option>
                    </select>
                    <span asp-validation-for="ContentType" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Privacy Mode -->
                <div>
                    <label asp-for="PrivacyMode" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2"></label>
                    <select asp-for="PrivacyMode"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all">
                        <option value="@((int)PrivacyMode.FriendsOnly)" selected="@(Model.PrivacyMode == PrivacyMode.FriendsOnly)">Solo Amigos</option>
                        <option value="@((int)PrivacyMode.OnlyMe)" selected="@(Model.PrivacyMode == PrivacyMode.OnlyMe)">Solo Yo</option>
                    </select>
                    <span asp-validation-for="PrivacyMode" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Comment Status -->
                <div class="flex items-center h-full pt-4 md:pt-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="CommentStatus" value="@((int)CommentStatus.Allowed)" @(Model.CommentStatus == CommentStatus.Allowed ? "checked" : "")
                            class="w-4 h-4 text-brand-blue border-gray-300 rounded focus:ring-brand-blue" />
                        <input type="hidden" name="CommentStatus" value="@((int)CommentStatus.NotAllowed)" />
                        <span class="text-sm font-medium text-gray-700">Permitir comentarios</span>
                    </label>
                </div>
            </div>

            <!-- Conditional Media Inputs -->
            <div id="imageFieldGroup" class="bg-gray-50 p-4 rounded-xl border border-gray-300 space-y-3">
                @if (ViewBag.CurrentMediaUrl != null)
                {
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Imagen Actual</label>
                        <img src="@ViewBag.CurrentMediaUrl" class="h-32 object-cover rounded-lg border border-gray-200" />
                    </div>
                }
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Reemplazar Imagen</label>
                    <input type="file" name="ImageFile" accept=".jpg,.jpeg,.png,.webp" id="imageInput"
                        class="w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-blue file:text-white hover:file:bg-blue-800 file:cursor-pointer" />
                    <p class="text-xs text-gray-400 mt-1">Formatos permitidos: .jpg, .jpeg, .png, .webp. Máximo 5 MB. Si se deja vacío se conservará la imagen actual.</p>
                </div>
            </div>

            <div id="videoFieldGroup" class="bg-gray-50 p-4 rounded-xl border border-gray-300 hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1">Enlace de YouTube</label>
                <input type="url" name="MediaUrl" id="videoUrlInput" value="@Model.MediaUrl"
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition-all"
                    placeholder="https://www.youtube.com/watch?v=..." />
                <p class="text-xs text-gray-400 mt-1">Ingrese la dirección del video completo de YouTube.</p>
            </div>

            <!-- Buttons -->
            <div class="flex gap-3 pt-4 border-t border-gray-100">
                <a asp-controller="Home" asp-action="Index" class="flex-1 text-center py-2.5 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="flex-1 bg-brand-blue text-white py-2.5 rounded-lg font-bold hover:bg-blue-800 transition-colors shadow-md">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleMediaFields() {
            const type = document.getElementById('editContentType').value;
            const imageGroup = document.getElementById('imageFieldGroup');
            const videoGroup = document.getElementById('videoFieldGroup');

            if (type == '@((int)ContentType.Image)' || type == 'Image' || type == '2') {
                imageGroup.classList.remove('hidden');
                videoGroup.classList.add('hidden');
            } else {
                imageGroup.classList.add('hidden');
                videoGroup.classList.remove('hidden');
            }
        }

        document.addEventListener('DOMContentLoaded', toggleMediaFields);
    </script>
}
