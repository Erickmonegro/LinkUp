@{
    ViewData["Title"] = "Error del Sistema";
    ViewData["HideNav"] = true;
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-indigo-50 to-slate-100 px-4 py-12">
    <div class="w-full max-w-lg">
        <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 border border-gray-100 text-center relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-red-500 via-amber-500 to-brand-blue"></div>
            
            <div class="w-20 h-20 bg-red-50 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner border border-red-100 transform -rotate-3 hover:rotate-0 transition-transform duration-300">
                <i class="fas fa-exclamation-triangle text-red-500 text-3xl animate-pulse"></i>
            </div>
            
            <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">
                ¡Vaya! Ha ocurrido un inconveniente
            </h1>
            
            <p class="text-gray-600 text-sm md:text-base mb-8 leading-relaxed">
                Lo sentimos, se ha producido un error inesperado al procesar su solicitud. Por motivos de seguridad, los detalles técnicos han sido registrados para nuestro equipo de soporte. Por favor, intente nuevamente en unos instantes.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a asp-action="Index" asp-controller="Home" class="inline-flex items-center justify-center gap-2 bg-brand-blue text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-blue-800 transition-all shadow-lg hover:shadow-blue-500/25 cursor-pointer">
                    <i class="fas fa-home"></i>
                    <span>Volver al Inicio</span>
                </a>
                <button onclick="window.history.back()" class="inline-flex items-center justify-center gap-2 bg-gray-100 text-gray-700 px-6 py-3 rounded-xl font-bold text-sm hover:bg-gray-200 transition-all border border-gray-200 cursor-pointer">
                    <i class="fas fa-arrow-left"></i>
                    <span>Regresar</span>
                </button>
            </div>
        </div>

        <div class="text-center mt-6">
            <p class="text-xs text-gray-400">
                &copy; @DateTime.UtcNow.Year LinkUp Pro — Sistema de Conectividad y Entretenimiento
            </p>
        </div>
    </div>
</div>
