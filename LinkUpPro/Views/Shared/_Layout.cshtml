@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using LinkUpPro.Infrastructure.Identity.Entities
@inject LinkUpPro.Core.Application.Interfaces.IFriendRequestService FriendRequestService
@inject LinkUpPro.Core.Application.Interfaces.INotificationService NotificationService
@inject LinkUpPro.Core.Application.Interfaces.IFriendshipService FriendshipService
@inject UserManager<AppUser> UserManager

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int pendingRequestsCount = 0;
    int unreadNotificationsCount = 0;
    int friendsCount = 0;
    AppUser? currentUser = null;

    if (userId != null)
    {
        pendingRequestsCount = await FriendRequestService.GetPendingCountAsync(userId);
        unreadNotificationsCount = await NotificationService.GetUnreadCountAsync(userId);
        currentUser = await UserManager.FindByIdAsync(userId);
        friendsCount = await FriendshipService.GetActiveFriendsCountAsync(userId);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkUp Pro</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-blue': '#060396',
                        'bg-soft': '#e8edf3'
                    },
                    fontFamily: {
                        sans: ['Segoe UI', 'Roboto', 'Helvetica Neue', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="flex flex-col min-h-screen bg-bg-soft text-gray-800">

    @if (ViewData["HideNav"] is not true)
    {
        <header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-infinity text-brand-blue text-2xl"></i>
                        <a asp-controller="Home" asp-action="Index" class="font-bold text-xl tracking-tight text-gray-900">
                            LinkUp <span class="text-brand-blue">Pro</span>
                        </a>
                    </div>
                    <div class="flex items-center space-x-2 md:space-x-4">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Home" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors text-sm md:text-base">Home</a>
                            
                            <a asp-controller="Friendship" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors text-sm md:text-base">Amigos</a>
                            
                            <a asp-controller="FriendRequest" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors relative text-sm md:text-base">
                                Solicitudes
                                @if (pendingRequestsCount > 0)
                                {
                                    <span class="absolute top-0 right-0 transform translate-x-1/2 -translate-y-1/2 bg-red-500 text-white rounded-full text-xs w-5 h-5 flex items-center justify-center font-bold">
                                        @pendingRequestsCount
                                    </span>
                                }
                            </a>
                            
                            <a asp-controller="Notification" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors relative text-sm md:text-base">
                                Notificaciones
                                @if (unreadNotificationsCount > 0)
                                {
                                    <span class="absolute top-0 right-0 transform translate-x-1/2 -translate-y-1/2 bg-red-500 text-white rounded-full text-xs w-5 h-5 flex items-center justify-center font-bold">
                                        @unreadNotificationsCount
                                    </span>
                                }
                            </a>
                            
                            <a asp-controller="Battleship" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors text-sm md:text-base">Battleship</a>
                            
                            <a asp-controller="Profile" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors text-sm md:text-base flex items-center gap-1.5">
                                @if (currentUser != null && !string.IsNullOrEmpty(currentUser.ProfilePhoto))
                                {
                                    <img src="@currentUser.ProfilePhoto" alt="Foto" class="w-6 h-6 rounded-full object-cover border border-gray-300" />
                                }
                                else
                                {
                                    <i class="fas fa-user-circle"></i>
                                }
                                <span class="hidden sm:inline">Mi Perfil</span>
                            </a>
                            
                            <form asp-controller="User" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-red-600 hover:text-red-800 font-medium px-2 py-1 md:px-3 md:py-2 rounded-md transition-colors text-sm md:text-base">
                                    <i class="fas fa-sign-out-alt"></i> <span class="hidden sm:inline">Salir</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="User" asp-action="Login" class="text-gray-600 hover:text-brand-blue font-medium px-3 py-2 rounded-md transition-colors">Iniciar Sesión</a>
                            <a asp-controller="User" asp-action="Register" class="bg-brand-blue text-white font-medium px-4 py-2 rounded-md transition-colors hover:bg-blue-800">Registrarse</a>
                        }
                    </div>
                </div>
            </nav>
        </header>
    }

    <main class="flex-grow @(ViewData["HideNav"] is true ? "flex flex-col" : "max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6")">

        @if (ViewData["HideNav"] is not true
             && User.Identity != null
             && User.Identity.IsAuthenticated
             && currentUser != null)
        {
            <div class="flex gap-6 items-start">

                <!-- Sidebar izquierdo: visible en md+ -->
                <aside class="hidden md:flex flex-col w-64 flex-shrink-0 sticky top-20">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 flex flex-col items-center gap-3">

                        @if (!string.IsNullOrEmpty(currentUser.ProfilePhoto))
                        {
                            <img src="@currentUser.ProfilePhoto"
                                 alt="Foto de perfil"
                                 class="w-20 h-20 rounded-full object-cover border-2 border-brand-blue shadow-sm" />
                        }
                        else
                        {
                            <div class="w-20 h-20 rounded-full bg-gray-100 border-2 border-gray-300 flex items-center justify-center text-gray-400">
                                <i class="fas fa-user-circle text-5xl"></i>
                            </div>
                        }

                        <div class="text-center">
                            <p class="font-bold text-gray-900 text-base leading-tight">
                                @currentUser.Name @currentUser.LastName
                            </p>
                            <p class="text-sm text-gray-500 mt-0.5">
                                @@currentUser.UserName
                            </p>
                        </div>

                        <hr class="w-full border-gray-100" />

                        <div class="flex items-center gap-2 text-sm text-gray-600">
                            <i class="fas fa-user-friends text-brand-blue"></i>
                            <span><strong class="text-gray-900">@friendsCount</strong> amigos</span>
                        </div>

                        <a asp-controller="Profile" asp-action="Index"
                           class="w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-2 rounded-lg transition-colors mt-1">
                            Ver mi perfil
                        </a>

                    </div>
                </aside>

                <!-- Contenido principal -->
                <div class="flex-1 min-w-0">
                    @RenderBody()
                </div>

            </div>
        }
        else
        {
            @RenderBody()
        }

    </main>

    @if (ViewData["HideNav"] is not true)
    {
        <footer class="bg-white border-t border-gray-200 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-sm text-gray-500">
                &copy; 2026 - LinkUp Pro - <a asp-controller="Home" asp-action="Privacy" class="hover:text-brand-blue transition-colors">Privacidad</a>
            </div>
        </footer>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>