<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkUp Pro</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        'brand-blue': '#060396',
        'bg-soft': '#e8edf3' /* Gris azulado suave */
        },
        fontFamily: {
        sans: ['Segoe UI', 'Roboto', 'Helvetica Neue', 'sans-serif'],
        }
        }
        }
        }
    </script>
</head>
<body class="flex flex-col min-h-screen bg-bg-soft text-gray-800">

    @if (ViewData["HideNav"] is not true)
    {
        <header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-infinity text-brand-blue text-2xl"></i>
                        <a asp-controller="Home" asp-action="Index" class="font-bold text-xl tracking-tight text-gray-900">
                            LinkUp <span class="text-brand-blue">Pro</span>
                        </a>
                    </div>
                    <div class="flex items-center space-x-4">
                        <a asp-controller="Home" asp-action="Index" class="text-gray-600 hover:text-brand-blue font-medium px-3 py-2 rounded-md transition-colors">Inicio</a>
                        <a asp-controller="Home" asp-action="Privacy" class="text-gray-600 hover:text-brand-blue font-medium px-3 py-2 rounded-md transition-colors">Privacidad</a>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main class="flex-grow flex flex-col @(ViewData["HideNav"] is true ? "" : "max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6")">
        @RenderBody()
    </main>

    @if (ViewData["HideNav"] is not true)
    {
        <footer class="bg-white border-t border-gray-200 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-sm text-gray-500">
                &copy; 2026 - LinkUp Pro - <a asp-controller="Home" asp-action="Privacy" class="hover:text-brand-blue transition-colors">Privacidad</a>
            </div>
        </footer>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>