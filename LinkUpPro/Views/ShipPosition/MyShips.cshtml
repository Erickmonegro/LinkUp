@using LinkUpPro.Core.Application.ViewModels.Battleship
@using LinkUpPro.Core.Domain.Common.Enums
@model IEnumerable<ShipPositionViewModel>

@{
    ViewData["Title"] = "Mis Barcos Desplegados";
    int matchId = ViewBag.MatchId ?? Model.FirstOrDefault()?.BattleshipMatchId ?? 0;
    string playerId = ViewBag.PlayerId ?? Model.FirstOrDefault()?.UserId ?? "";
    
    // Calcular celdas ocupadas por barcos
    var occupiedCells = new Dictionary<string, ShipPositionViewModel>();
    foreach (var ship in Model)
    {
        for (int i = 0; i < ship.ShipSize; i++)
        {
            int x = ship.StartX;
            int y = ship.StartY;
            if (ship.Direction == ShipDirection.Up) y -= i;
            else if (ship.Direction == ShipDirection.Down) y += i;
            else if (ship.Direction == ShipDirection.Left) x -= i;
            else if (ship.Direction == ShipDirection.Right) x += i;
            occupiedCells[$"{x},{y}"] = ship;
        }
    }
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue text-2xl shadow-sm">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">Mi Flota Naval</h2>
                <p class="text-sm text-gray-500">Visualiza la disposición y el estado de tus navíos de combate</p>
            </div>
        </div>
        <div class="flex gap-3">
            @if (Model.Count() < 5 && matchId > 0)
            {
                <a asp-controller="ShipPosition" asp-action="PlaceShip" asp-route-matchId="@matchId"
                   class="bg-green-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-green-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2 animate-pulse">
                    <i class="fas fa-plus-circle"></i> Continuar Colocando Barcos (@Model.Count()/5)
                </a>
            }
            @if (matchId > 0)
            {
                <a asp-controller="Battleship" asp-action="Details" asp-route-id="@matchId"
                   class="bg-gray-100 text-gray-700 px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors flex items-center gap-2">
                    <i class="fas fa-arrow-left"></i> Volver a la Sala
                </a>
            }
            else
            {
                <a asp-controller="Battleship" asp-action="Index"
                   class="bg-gray-100 text-gray-700 px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors flex items-center gap-2">
                    <i class="fas fa-arrow-left"></i> Volver al Listado
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-info-circle text-blue-500 text-lg"></i>
            <span>@TempData["Info"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <!-- Tablero Visual de la Flota -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 lg:col-span-2 overflow-x-auto">
            <div class="flex items-center justify-between mb-4">
                <span class="text-sm font-extrabold text-gray-700 tracking-wider uppercase flex items-center gap-2">
                    <i class="fas fa-map text-brand-blue"></i> Mapa de Posicionamiento 12x12
                </span>
                <span class="text-xs font-bold px-3 py-1 bg-blue-50 text-blue-700 rounded-full">
                    Navíos desplegados: @Model.Count() de 5
                </span>
            </div>

            <div class="inline-block min-w-[360px] w-full max-w-lg mx-auto bg-slate-900 p-3 rounded-2xl shadow-xl border-4 border-slate-800">
                <div class="grid grid-cols-12 gap-1.5 aspect-square">
                    @for (int row = 0; row < 12; row++)
                    {
                        for (int col = 0; col < 12; col++)
                        {
                            string coordKey = $"{col},{row}";
                            if (occupiedCells.TryGetValue(coordKey, out var ship))
                            {
                                string bgClass = ship.IsSunk ? "bg-red-600 border-red-500 text-white animate-pulse" : "bg-brand-blue border-blue-400 text-white shadow-md";
                                <div class="board-cell @bgClass flex items-center justify-center rounded-lg border transition-all title='Barco de @ship.ShipSize casillas (@(ship.IsSunk ? "Hundido" : "Activo"))'">
                                    <i class="fas fa-ship text-xs sm:text-sm md:text-base"></i>
                                </div>
                            }
                            else
                            {
                                <div class="board-cell bg-slate-800 border border-slate-700 flex items-center justify-center rounded-lg text-slate-600 title='Agua libre (@col, @row)'">
                                    <i class="fas fa-water text-xs sm:text-sm md:text-base opacity-20"></i>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-6 mt-6 text-xs font-bold text-gray-600">
                <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded bg-slate-800 border border-slate-700"></span>
                    <span>Mar Libre</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded bg-brand-blue text-white flex items-center justify-center"><i class="fas fa-ship text-[10px]"></i></span>
                    <span>Navío Intacto</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded bg-red-600 text-white flex items-center justify-center"><i class="fas fa-skull text-[10px]"></i></span>
                    <span>Navío Hundido</span>
                </div>
            </div>
        </div>

        <!-- Listado de Barcos -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-4 lg:col-span-1">
            <h3 class="text-lg font-black text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
                <i class="fas fa-clipboard-list text-brand-blue"></i> Registro de Navíos
            </h3>

            @if (Model.Any())
            {
                <div class="space-y-3">
                    @foreach (var ship in Model)
                    {
                        <div class="p-4 rounded-xl border @(ship.IsSunk ? "bg-red-50/50 border-red-200" : "bg-gray-50 border-gray-200") flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg @(ship.IsSunk ? "bg-red-100 text-red-600" : "bg-blue-100 text-brand-blue") flex items-center justify-center text-lg font-bold">
                                    <i class="fas fa-ship"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 text-sm">Barco de @ship.ShipSize casillas</h4>
                                    <p class="text-xs text-gray-500">Inicio: (@ship.StartX, @ship.StartY) • Dir: @ship.Direction</p>
                                </div>
                            </div>
                            <div class="text-right">
                                @if (ship.IsSunk)
                                {
                                    <span class="px-2.5 py-1 bg-red-100 text-red-800 rounded-full text-[11px] font-black uppercase tracking-wider">Hundido</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-green-100 text-green-800 rounded-full text-[11px] font-black uppercase tracking-wider">Activo</span>
                                }
                                <p class="text-xs font-bold text-gray-600 mt-1">Impactos: @ship.Hits / @ship.ShipSize</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                    <i class="fas fa-ship text-3xl text-gray-300 mb-2"></i>
                    <p class="text-sm font-bold text-gray-600">Aún no has posicionado ningún barco</p>
                    <p class="text-xs text-gray-400 mt-1">Despliega tus navíos en el tablero para prepararte para el combate.</p>
                </div>
            }
        </div>

    </div>
</div>
