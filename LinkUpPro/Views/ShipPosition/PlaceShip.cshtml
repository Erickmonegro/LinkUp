@using LinkUpPro.Core.Application.ViewModels.Battleship
@using LinkUpPro.Core.Domain.Common.Enums
@model ShipPositionViewModel

@{
    ViewData["Title"] = "Colocar Barcos";
    var occupiedCells = ViewBag.OccupiedCells as HashSet<string> ?? new HashSet<string>();
    int count2 = ViewBag.Count2 ?? 0;
    int count3 = ViewBag.Count3 ?? 0;
    int count4 = ViewBag.Count4 ?? 0;
    int count5 = ViewBag.Count5 ?? 0;
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue text-2xl shadow-sm">
                <i class="fas fa-ship"></i>
            </div>
            <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">Despliegue de Flota</h2>
                <p class="text-sm text-gray-500">Posiciona estratégicamente tus navíos de combate en el tablero</p>
            </div>
        </div>
        <div>
            <a asp-controller="Battleship" asp-action="Details" asp-route-id="@Model.BattleshipMatchId" 
               class="bg-gray-100 text-gray-700 px-4 py-2 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors flex items-center gap-2">
                <i class="fas fa-arrow-left"></i> Volver a la Sala
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-info-circle text-blue-500 text-lg"></i>
            <span>@TempData["Info"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium shadow-sm">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (Model.ShipSize == 0)
    {
        <!-- PANTALLA 1: SELECCIÓN DE BARCO -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 max-w-2xl mx-auto">
            <h3 class="text-xl font-extrabold text-gray-900 mb-2 flex items-center gap-2">
                <i class="fas fa-list-ul text-brand-blue"></i> Selecciona un barco para posicionar:
            </h3>
            <p class="text-sm text-gray-500 mb-6">Elige el navío que deseas desplegar en tu tablero naval. Cada barco tiene un tamaño específico en casillas.</p>

            <form asp-action="PlaceShip" method="get" class="space-y-4">
                <input type="hidden" name="matchId" value="@Model.BattleshipMatchId" />

                <div class="space-y-3">
                    @if (count2 < 1)
                    {
                        <label class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:border-brand-blue hover:bg-blue-50/50 transition-all group">
                            <div class="flex items-center gap-4">
                                <input type="radio" name="shipSize" value="2" required class="w-5 h-5 text-brand-blue focus:ring-brand-blue border-gray-300" />
                                <div>
                                    <span class="font-bold text-gray-900 block group-hover:text-brand-blue transition-colors">Lancha de Patrulla</span>
                                    <span class="text-xs text-gray-500 font-medium">Tamaño: 2 casillas</span>
                                </div>
                            </div>
                            <div class="flex gap-1 text-brand-blue bg-blue-100/50 px-3 py-1.5 rounded-lg border border-blue-200">
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                            </div>
                        </label>
                    }

                    @if (count3 < 2)
                    {
                        for (int i = 0; i < (2 - count3); i++)
                        {
                            <label class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:border-brand-blue hover:bg-blue-50/50 transition-all group">
                                <div class="flex items-center gap-4">
                                    <input type="radio" name="shipSize" value="3" required class="w-5 h-5 text-brand-blue focus:ring-brand-blue border-gray-300" />
                                    <div>
                                        <span class="font-bold text-gray-900 block group-hover:text-brand-blue transition-colors">@(i == 0 && count3 == 0 ? "Submarino" : "Destructor")</span>
                                        <span class="text-xs text-gray-500 font-medium">Tamaño: 3 casillas</span>
                                    </div>
                                </div>
                                <div class="flex gap-1 text-sky-600 bg-sky-100/50 px-3 py-1.5 rounded-lg border border-sky-200">
                                    <i class="fas fa-ship"></i>
                                    <i class="fas fa-ship"></i>
                                    <i class="fas fa-ship"></i>
                                </div>
                            </label>
                        }
                    }

                    @if (count4 < 1)
                    {
                        <label class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:border-brand-blue hover:bg-blue-50/50 transition-all group">
                            <div class="flex items-center gap-4">
                                <input type="radio" name="shipSize" value="4" required class="w-5 h-5 text-brand-blue focus:ring-brand-blue border-gray-300" />
                                <div>
                                    <span class="font-bold text-gray-900 block group-hover:text-brand-blue transition-colors">Acorazado</span>
                                    <span class="text-xs text-gray-500 font-medium">Tamaño: 4 casillas</span>
                                </div>
                            </div>
                            <div class="flex gap-1 text-indigo-600 bg-indigo-100/50 px-3 py-1.5 rounded-lg border border-indigo-200">
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                            </div>
                        </label>
                    }

                    @if (count5 < 1)
                    {
                        <label class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:border-brand-blue hover:bg-blue-50/50 transition-all group">
                            <div class="flex items-center gap-4">
                                <input type="radio" name="shipSize" value="5" required class="w-5 h-5 text-brand-blue focus:ring-brand-blue border-gray-300" />
                                <div>
                                    <span class="font-bold text-gray-900 block group-hover:text-brand-blue transition-colors">Portaaviones</span>
                                    <span class="text-xs text-gray-500 font-medium">Tamaño: 5 casillas</span>
                                </div>
                            </div>
                            <div class="flex gap-1 text-purple-600 bg-purple-100/50 px-3 py-1.5 rounded-lg border border-purple-200">
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                                <i class="fas fa-ship"></i>
                            </div>
                        </label>
                    }
                </div>

                <div class="pt-4 flex items-center justify-between gap-4">
                    <a asp-action="MyShips" asp-route-matchId="@Model.BattleshipMatchId" asp-route-playerId="@Model.UserId" 
                       class="bg-gray-100 text-gray-700 px-5 py-3 rounded-xl font-bold hover:bg-gray-200 transition-colors">
                        Ver Mis Barcos
                    </a>

                    <button type="submit" class="bg-green-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-green-700 transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                        <span>Posicionar barco</span> <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <!-- PANTALLA 2: TABLERO DE POSICIONAMIENTO 12x12 -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            <!-- Controles de Orientación y Envío -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 space-y-6 lg:col-span-1">
                <div>
                    <span class="px-3 py-1 bg-brand-blue/10 text-brand-blue rounded-full text-xs font-black uppercase tracking-wider">Navío Seleccionado</span>
                    <h3 class="text-xl font-black text-gray-900 mt-2">Barco de @Model.ShipSize casillas</h3>
                    <p class="text-xs text-gray-500 mt-1">Haz clic en una celda libre del tablero como punto de partida y selecciona la dirección.</p>
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-bold text-gray-800">1. Orientación del barco:</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" data-dir="1" class="dir-btn bg-white text-gray-700 border border-gray-300 py-2.5 px-3 rounded-xl font-bold text-sm hover:border-brand-blue transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-up"></i> Arriba
                        </button>
                        <button type="button" data-dir="2" class="dir-btn bg-white text-gray-700 border border-gray-300 py-2.5 px-3 rounded-xl font-bold text-sm hover:border-brand-blue transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-down"></i> Abajo
                        </button>
                        <button type="button" data-dir="3" class="dir-btn bg-white text-gray-700 border border-gray-300 py-2.5 px-3 rounded-xl font-bold text-sm hover:border-brand-blue transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-left"></i> Izquierda
                        </button>
                        <button type="button" data-dir="4" class="dir-btn bg-brand-blue text-white shadow-md border border-brand-blue py-2.5 px-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-right"></i> Derecha
                        </button>
                    </div>
                </div>

                <div class="bg-amber-50 rounded-xl p-3 border border-amber-200 text-amber-800 text-xs font-medium space-y-1">
                    <p class="font-bold flex items-center gap-1.5"><i class="fas fa-exclamation-triangle"></i> Regla de ubicación:</p>
                    <p>Las celdas en gris ya están ocupadas por tus barcos. Si la posición es inválida o sale del tablero, se iluminará en <span class="font-bold text-red-600">rojo</span>.</p>
                </div>

                <form id="placeShipForm" asp-action="PlaceShip" method="post" class="space-y-3 pt-2">
                    <input asp-for="BattleshipMatchId" type="hidden" />
                    <input asp-for="UserId" type="hidden" />
                    <input asp-for="ShipSize" type="hidden" id="ShipSizeInput" />
                    <input asp-for="StartX" type="hidden" id="StartXInput" value="-1" />
                    <input asp-for="StartY" type="hidden" id="StartYInput" value="-1" />
                    <input asp-for="Direction" type="hidden" id="DirectionInput" value="4" />

                    <button type="submit" id="submitShipBtn" disabled
                            class="w-full bg-green-600 text-white py-3 px-4 rounded-xl font-extrabold text-base transition-all shadow-md opacity-50 cursor-not-allowed flex items-center justify-center gap-2">
                        <i class="fas fa-check"></i> Posicionar Barco
                    </button>

                    <a asp-action="PlaceShip" asp-route-matchId="@Model.BattleshipMatchId"
                       class="w-full block text-center bg-gray-100 text-gray-700 py-2.5 px-4 rounded-xl font-bold text-sm hover:bg-gray-200 transition-colors">
                        Elegir otro barco
                    </a>
                </form>
            </div>

            <!-- Tablero 12x12 -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 lg:col-span-2 overflow-x-auto">
                <div class="text-center mb-4">
                    <span class="text-sm font-extrabold text-gray-700 tracking-wider uppercase">Tablero Naval 12x12</span>
                </div>

                <div class="inline-block min-w-[360px] w-full max-w-lg mx-auto bg-slate-900 p-3 rounded-2xl shadow-xl border-4 border-slate-800">
                    <div class="grid grid-cols-12 gap-1.5 aspect-square">
                        @for (int row = 0; row < 12; row++)
                        {
                            for (int col = 0; col < 12; col++)
                            {
                                string coordKey = $"{col},{row}";
                                bool isOccupied = occupiedCells.Contains(coordKey);

                                if (isOccupied)
                                {
                                    <div class="bg-gray-500 text-white cursor-not-allowed flex items-center justify-center rounded-lg border border-gray-600 shadow-inner title='Celda ocupada'"
                                         onclick="alert('Al hacer click sobre esa celda el app no hará nada porque la misma ya está ocupada.');">
                                        <i class="fas fa-ship text-xs sm:text-sm md:text-base opacity-90"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="board-cell bg-slate-800 hover:bg-slate-700 border border-slate-700 cursor-pointer flex items-center justify-center rounded-lg transition-all text-slate-400 hover:text-white group"
                                         data-x="@col" data-y="@row" title="Celda (@col, @row)">
                                        <i class="fas fa-ship text-xs sm:text-sm md:text-base opacity-40 group-hover:opacity-100 transition-opacity"></i>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-center gap-6 mt-6 text-xs font-bold text-gray-600">
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400"><i class="fas fa-ship text-[10px]"></i></span>
                        <span>Celda Libre</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-gray-500 text-white flex items-center justify-center"><i class="fas fa-ship text-[10px]"></i></span>
                        <span>Barco Ocupado</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-green-500 text-white"></span>
                        <span>Posición Válida</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-red-500 text-white"></span>
                        <span>Posición Inválida</span>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    @if (Model.ShipSize > 0)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const shipSize = @Model.ShipSize;
                const occupiedCells = new Set(@Html.Raw(Json.Serialize(occupiedCells)));
                
                let currentX = -1;
                let currentY = -1;
                let currentDir = 4; // Derecha por defecto (Right = 4)

                const startXInput = document.getElementById('StartXInput');
                const startYInput = document.getElementById('StartYInput');
                const directionInput = document.getElementById('DirectionInput');
                const submitBtn = document.getElementById('submitShipBtn');
                const dirButtons = document.querySelectorAll('.dir-btn');

                dirButtons.forEach(btn => {
                    btn.addEventListener('click', function() {
                        dirButtons.forEach(b => {
                            b.classList.remove('bg-brand-blue', 'text-white', 'shadow-md', 'border-brand-blue');
                            b.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
                        });
                        this.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
                        this.classList.add('bg-brand-blue', 'text-white', 'shadow-md', 'border-brand-blue');
                        currentDir = parseInt(this.getAttribute('data-dir'));
                        directionInput.value = currentDir;
                        updatePreview();
                    });
                });

                const cells = document.querySelectorAll('.board-cell');
                cells.forEach(cell => {
                    cell.addEventListener('click', function() {
                        currentX = parseInt(this.getAttribute('data-x'));
                        currentY = parseInt(this.getAttribute('data-y'));
                        startXInput.value = currentX;
                        startYInput.value = currentY;
                        updatePreview();
                    });
                });

                function updatePreview() {
                    // Remover estilos previos de vista previa
                    document.querySelectorAll('.preview-valid').forEach(el => {
                        el.classList.remove('preview-valid', '!bg-green-500', '!text-white', '!border-green-400', 'ring-2', 'ring-green-300', 'scale-105', 'z-10', '!opacity-100');
                    });
                    document.querySelectorAll('.preview-invalid').forEach(el => {
                        el.classList.remove('preview-invalid', '!bg-red-500', '!text-white', '!border-red-400', 'ring-2', 'ring-red-300', 'z-10', '!opacity-100');
                    });
                    document.querySelectorAll('.board-cell i').forEach(icon => {
                        if (!icon.parentElement.classList.contains('preview-valid') && !icon.parentElement.classList.contains('preview-invalid')) {
                            icon.classList.remove('!opacity-100');
                        }
                    });

                    if (currentX === -1 || currentY === -1) return;

                    let coords = [];
                    for (let i = 0; i < shipSize; i++) {
                        let cx = currentX;
                        let cy = currentY;
                        if (currentDir === 1) cy -= i;      // Up
                        else if (currentDir === 2) cy += i; // Down
                        else if (currentDir === 3) cx -= i; // Left
                        else if (currentDir === 4) cx += i; // Right
                        coords.push({ x: cx, y: cy });
                    }

                    let isValid = true;
                    for (let c of coords) {
                        if (c.x < 0 || c.x >= 12 || c.y < 0 || c.y >= 12 || occupiedCells.has(`${c.x},${c.y}`)) {
                            isValid = false;
                            break;
                        }
                    }

                    for (let c of coords) {
                        if (c.x >= 0 && c.x < 12 && c.y >= 0 && c.y < 12) {
                            const el = document.querySelector(`.board-cell[data-x="${c.x}"][data-y="${c.y}"]`);
                            if (el) {
                                const icon = el.querySelector('i');
                                if (isValid) {
                                    el.classList.add('preview-valid', '!bg-green-500', '!text-white', '!border-green-400', 'ring-2', 'ring-green-300', 'scale-105', 'z-10');
                                    if (icon) icon.classList.add('!opacity-100');
                                } else {
                                    el.classList.add('preview-invalid', '!bg-red-500', '!text-white', '!border-red-400', 'ring-2', 'ring-red-300', 'z-10');
                                    if (icon) icon.classList.add('!opacity-100');
                                }
                            }
                        }
                    }

                    if (isValid) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                        submitBtn.classList.add('hover:bg-green-700', 'hover:shadow-lg', 'cursor-pointer');
                    } else {
                        submitBtn.disabled = true;
                        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                        submitBtn.classList.remove('hover:bg-green-700', 'hover:shadow-lg', 'cursor-pointer');
                    }
                }
            });
        </script>
    }
}
